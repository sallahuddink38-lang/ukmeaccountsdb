/* ---- QuickBooks-style settings (Company / Sales / Expenses / Payments / Advanced) ---- */
const DEFAULT_SETTINGS = {
  company:{},   // overrides for COMPANY (name, regNo, vat, address, phone, email, website, bank...)
  sales:{ invPrefix:"UKME/INV/2026/", invPad:3, dueDays:30, incoterms:"", message:"" },
  expenses:{ poPrefix:"PO-2026-", poPad:3, destination:"Dubai, UAE", deliveryDays:7, creditDays:30, message:"" },
  payments:{ reminderDays:2 },
  advanced:{ fiscalStartMonth:1, idleMinutes:20 }
};
let settings = JSON.parse(JSON.stringify(DEFAULT_SETTINGS));
function mergeSettings(saved){
  const out = JSON.parse(JSON.stringify(DEFAULT_SETTINGS));
  if(saved && typeof saved==="object"){
    for(const k of Object.keys(out)){ if(saved[k] && typeof saved[k]==="object") out[k] = Object.assign({}, out[k], saved[k]); }
  }
  return out;
}
function applySettings(){
  const c = settings.company || {};
  if(c.name) COMPANY.name = c.name;
  if(c.regNo!==undefined) COMPANY.regNo = c.regNo;
  if(c.vat!==undefined) COMPANY.vat = c.vat;
  if(c.address!==undefined) COMPANY.addressLines = String(c.address).split(/\n/).map(x=>x.trim()).filter(Boolean);
  if(c.phone!==undefined) COMPANY.phone = c.phone;
  if(c.email!==undefined) COMPANY.email = c.email;
  if(c.website!==undefined) COMPANY.website = c.website;
  if(c.bank) COMPANY.bank = Object.assign({}, COMPANY.bank, c.bank);
}

/* Chart of accounts — manual/reference accounts the user maintains themselves
   (things this app has no ledger for yet, e.g. freight, rent, equity).
   AR / AP / Bank / Sales / Purchases are derived automatically from the
   invoices & purchase orders above and are NOT stored here — see
   buildDerivedAccounts() below. */
let manualAccounts = [
  { id:"acc-1", code:"3000", name:"Owner's Equity", type:"equity", balance:0, normal:"credit" },
  { id:"acc-2", code:"5100", name:"Freight & Logistics", type:"expense", balance:0, normal:"debit" },
  { id:"acc-3", code:"5200", name:"Customs, Duties & Clearance", type:"expense", balance:0, normal:"debit" },
  { id:"acc-4", code:"2200", name:"VAT Payable", type:"liability", balance:0, normal:"credit" }
];

/* ================= PERSISTENCE (IndexedDB — scales to 10,000+ invoices & POs) =================
   localStorage (the old approach) caps out around 5-10MB per browser and writes the WHOLE
   dataset as one JSON blob on every single change — fine for a few hundred records, but it
   will hit the quota and start lagging well before 10,000 invoices + POs. IndexedDB stores
   each invoice/PO as its own record, is asynchronous (doesn't freeze the UI on save), and has
   no realistic size ceiling for this kind of data. If IndexedDB isn't available for some
   reason, everything falls back to in-memory-only (session still works, just won't persist). */
const IDB_NAME = "ukme_erp_db";
const IDB_VERSION = 1;
const LEGACY_STORAGE_KEY = "ukme_erp_data_v1"; // old localStorage key, migrated once then left alone
let customSignature = null; // uploaded via Settings — overrides SIGNATURE_B64 placeholder (Authorised/Approved signature)
let customStamp = null;     // uploaded via Settings — overrides STAMP_B64 placeholder
let customPreparedSignature = null; // uploaded via Settings — overrides PREPARED_SIGNATURE_B64 placeholder ("Prepared By")
function currentSignatureImg(){ return customSignature || SIGNATURE_B64; }
function currentStampImg(){ return customStamp || STAMP_B64; }
function currentPreparedSignatureImg(){ return customPreparedSignature || PREPARED_SIGNATURE_B64; }

let _idbPromise = null;
function idbOpen(){
  if(_idbPromise) return _idbPromise;
  _idbPromise = new Promise((resolve)=>{
    if(!window.indexedDB){ resolve(null); return; }
    const req = indexedDB.open(IDB_NAME, IDB_VERSION);
    req.onupgradeneeded = function(){
      const db = req.result;
      if(!db.objectStoreNames.contains("invoices")) db.createObjectStore("invoices", {keyPath:"id"});
      if(!db.objectStoreNames.contains("purchase_orders")) db.createObjectStore("purchase_orders", {keyPath:"id"});
      if(!db.objectStoreNames.contains("meta")) db.createObjectStore("meta", {keyPath:"key"});
    };
    req.onsuccess = function(){ resolve(req.result); };
    req.onerror = function(){ resolve(null); }; // IndexedDB blocked/unavailable — degrade to in-memory only
  });
  return _idbPromise;
}
function idbTx(storeName, mode){
  return idbOpen().then(db=>{
    if(!db) return null;
    return db.transaction(storeName, mode).objectStore(storeName);
  });
}
function idbPut(storeName, value){
  return idbTx(storeName, "readwrite").then(store=>new Promise(resolve=>{
    if(!store){ resolve(false); return; }
    const req = store.put(value);
    req.onsuccess = ()=>{ schedulePush(); resolve(true); };
    req.onerror = ()=>resolve(false);
  }));
}
function idbDelete(storeName, key){
  return idbTx(storeName, "readwrite").then(store=>new Promise(resolve=>{
    if(!store){ resolve(false); return; }
    const req = store.delete(key);
    req.onsuccess = ()=>{ schedulePush(); resolve(true); };
    req.onerror = ()=>resolve(false);
  }));
}
function idbGetAll(storeName){
  return idbTx(storeName, "readonly").then(store=>new Promise(resolve=>{
    if(!store){ resolve([]); return; }
    const req = store.getAll();
    req.onsuccess = ()=>resolve(req.result || []);
    req.onerror = ()=>resolve([]);
  }));
}
function idbClearAll(){
  return idbOpen().then(db=>{
    if(!db) return;
    ["invoices","purchase_orders","meta"].forEach(name=>{
      try{ db.transaction(name,"readwrite").objectStore(name).clear(); }catch(e){}
    });
  });
}

/* targeted saves — only the record that actually changed is written, so this stays fast at
   any dataset size instead of re-serialising everything on every keystroke */
function saveInvoiceRecord(inv){ idbPut("invoices", inv); }
function savePORecord(po){ idbPut("purchase_orders", po); }
function deleteInvoiceRecord(id){ idbDelete("invoices", id); }
function deletePORecord(id){ idbDelete("purchase_orders", id); }
function saveMeta(){
  // initialized:true marks that this browser has a real (possibly empty) dataset,
  // so an empty invoices/PO list after deleting everything is never confused with
  // "nothing saved yet" — see the bug note in loadState() below.
  idbPut("meta", { key:"meta", initialized:true, seq, manualAccounts, customSignature, customStamp, customPreparedSignature, settings });
}
/* legacy name kept so nothing calling the old all-in-one save silently breaks; only used for
   the (rare) case where several things changed in one action and a full write is simplest */
function saveState(){
  invoices.forEach(saveInvoiceRecord);
  purchaseOrders.forEach(savePORecord);
  saveMeta();
}

/* ---- Company file on disk (server.js) — the source of truth when the app is opened via the local server.
   IndexedDB above stays as a fallback/cache, so opening index.html directly still works as before. ---- */
let serverReady = false, _pushTimer = null, _pushWarned = false;
function snapshot(){ return { savedAt:new Date().toISOString(), initialized:true, invoices, purchaseOrders, seq, manualAccounts, customSignature, customStamp, customPreparedSignature, settings }; }
async function serverGet(){
  try{
    if(location.protocol==="file:") return null;
    const r = await fetch("/api/data",{cache:"no-store"});
    if(r.status===404) return { data:null };
    if(!r.ok) return null;
    return { data: await r.json() };
  }catch(e){ return null; }          // no server → fall back to browser storage only
}
function schedulePush(){ if(!serverReady) return; clearTimeout(_pushTimer); _pushTimer = setTimeout(pushNow, 400); }
async function pushNow(){
  try{
    const r = await fetch("/api/data",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify(snapshot())});
    if(!r.ok) throw new Error("HTTP "+r.status);
    _pushWarned = false;
  }catch(e){
    if(!_pushWarned){ _pushWarned = true; alert("Could not save to the company file (is the server window still open?).\nYour change is kept in this browser, and will be saved to the file on the next successful save."); }
  }
}
function serverDelete(){ return fetch("/api/data",{method:"DELETE"}).catch(()=>{}); }

async function loadState(){
  const remote = await serverGet();
  if(remote && remote.data){                       // the company file wins: load it into the local cache first
    const d = remote.data;
    await idbClearAll();
    (d.invoices||[]).forEach(x=>idbPut("invoices",x));
    (d.purchaseOrders||[]).forEach(x=>idbPut("purchase_orders",x));
    idbPut("meta",{ key:"meta", initialized:true, seq:d.seq, manualAccounts:d.manualAccounts, customSignature:d.customSignature, customStamp:d.customStamp, customPreparedSignature:d.customPreparedSignature, settings:d.settings });
  }
  await loadStateLocal();
  if(remote){ serverReady = true; if(!remote.data) await pushNow(); }   // first run: create the file from what's in this browser
}

async function loadStateLocal(){
  const [dbInvoices, dbPOs, metaRows] = await Promise.all([
    idbGetAll("invoices"), idbGetAll("purchase_orders"), idbGetAll("meta")
  ]);
  const meta = metaRows.find(m=>m.key==="meta");

  if((meta && meta.initialized) || dbInvoices.length || dbPOs.length || meta){
    // IndexedDB already has data from a previous session — use it as-is.
    // IMPORTANT: once this browser has been initialized (meta.initialized === true),
    // invoices/purchaseOrders are ALWAYS taken from IndexedDB even when the array
    // comes back empty — e.g. after deleting every invoice or every PO. Checking
    // ".length" here instead (the old bug) meant an empty result looked identical
    // to "nothing saved yet", so the code fell through and kept the original
    // built-in sample invoices/POs — which is exactly why deleted items appeared
    // to "come back" after a refresh once you deleted the last one.
    if(meta && meta.initialized){ invoices = dbInvoices; purchaseOrders = dbPOs; }
    else{
      if(dbInvoices.length) invoices = dbInvoices;
      if(dbPOs.length) purchaseOrders = dbPOs;
    }
    if(meta){
      if(meta.seq) seq = meta.seq;
      if(meta.manualAccounts) manualAccounts = meta.manualAccounts;
      if(meta.customSignature) customSignature = meta.customSignature;
      if(meta.customStamp) customStamp = meta.customStamp;
      if(meta.customPreparedSignature) customPreparedSignature = meta.customPreparedSignature;
      if(meta.settings) settings = mergeSettings(meta.settings);
    }
    applySettings();
    return;
  }

  // nothing in IndexedDB yet — check for data saved by the old localStorage version and
  // migrate it in once, so nobody loses their existing invoices/POs on this update
  try{
    const raw = localStorage.getItem(LEGACY_STORAGE_KEY);
    if(raw){
      const data = JSON.parse(raw);
      if(data.invoices) invoices = data.invoices;
      if(data.purchaseOrders) purchaseOrders = data.purchaseOrders;
      if(data.seq) seq = data.seq;
      if(data.manualAccounts) manualAccounts = data.manualAccounts;
      if(data.customSignature) customSignature = data.customSignature;
      if(data.customStamp) customStamp = data.customStamp;
      if(data.customPreparedSignature) customPreparedSignature = data.customPreparedSignature;
      localStorage.removeItem(LEGACY_STORAGE_KEY);
    }
  }catch(e){ /* nothing to migrate, or it was corrupted — fine, sample data stays */ }

  // first run (or fresh migration) — persist whatever we're starting with (sample data,
  // or the migrated data) into IndexedDB
  saveState();
}
function resetToSampleData(){
  const typed = prompt("This permanently wipes every invoice, PO and setting in this browser and restores the original sample data.\n\nType RESET (in capitals) to confirm — anything else cancels:");
  if(typed !== "RESET") return;
  idbClearAll().then(()=>serverDelete()).then(()=>{ try{ localStorage.removeItem(LEGACY_STORAGE_KEY); }catch(e){} location.reload(); });
}

/* ============ BACKUP / RESTORE ============
   Safety net against storage loss (private/incognito tabs, some embedded
   previews like VS Code's built-in webview browser, "clear site data",
   or opening the file from a different path each time — any of these can
   make the browser's IndexedDB start empty again, which looks exactly like
   "my deleted items came back": what actually happened is the whole
   browser storage reset to the file's built-in sample data, not that
   anything you deleted was restored on purpose. Exporting regularly, and
   ALWAYS running this from the same fixed local server address (not a
   VS Code preview tab), is the real fix. */
function exportDataBackup(){
  const payload = { exportedAt:new Date().toISOString(), invoices, purchaseOrders, seq, manualAccounts,
    customSignature, customStamp, customPreparedSignature, settings };
  const blob = new Blob([JSON.stringify(payload,null,2)], {type:"application/json"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = "ukme-erp-backup-"+new Date().toISOString().slice(0,10)+".json";
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url), 1000);
}
function importDataBackup(evt){
  const file = evt.target.files && evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(){
    let data;
    try{ data = JSON.parse(reader.result); }
    catch(e){ alert("That file isn't a valid backup (couldn't be read as JSON)."); evt.target.value=""; return; }
    if(!data || !Array.isArray(data.invoices) || !Array.isArray(data.purchaseOrders)){
      alert("That file doesn't look like a UKME ERP backup."); evt.target.value=""; return;
    }
    const typed = prompt("This REPLACES everything currently in this browser with the contents of \""+file.name+"\" ("+data.invoices.length+" invoices, "+data.purchaseOrders.length+" POs).\n\nType RESTORE (in capitals) to confirm — anything else cancels:");
    if(typed !== "RESTORE"){ evt.target.value=""; return; }
    idbClearAll().then(async ()=>{
      invoices = data.invoices; purchaseOrders = data.purchaseOrders;
      seq = data.seq || seq; manualAccounts = data.manualAccounts || manualAccounts;
      customSignature = data.customSignature || null; customStamp = data.customStamp || null;
      customPreparedSignature = data.customPreparedSignature || null;
      settings = mergeSettings(data.settings);
      applySettings();
      saveState();
      if(serverReady) await pushNow();   // write the restored data to the company file before reloading
      try{ localStorage.removeItem(LEGACY_STORAGE_KEY); }catch(e){}
      alert("Backup restored.");
      location.reload();
    });
  };
  reader.readAsText(file);
}

/* ================= LOGIN (basic local access gate — see note in Settings) =================
   This is a client-side-only gate suited to a single shared computer, not real
   multi-user security: anyone with the file can read the source, open devtools
   and flip past the login screen, or read localStorage directly. There is no
   server, so this can only keep a casual visitor out — never a determined one.
   Within that honest limit, this uses a real SHA-256 hash (Web Crypto API,
   with a graceful fallback for very old / restricted browsers), a login
   lockout after repeated failed attempts, and an auto sign-out after
   inactivity. See the note in Settings for what this can't protect against. */
const AUTH_KEY = "ukme_erp_auth_v1";
const AUTH_SESSION_KEY = "ukme_erp_authed";
const LOCKOUT_KEY = "ukme_erp_login_lockout_v1";
function inactivityLimitMs(){ return Math.max(1, Number(settings.advanced.idleMinutes)||20) * 60 * 1000; } // auto sign-out (Settings → Advanced)

/* legacy weak hash — kept ONLY to verify/migrate passwords saved before this update */
function legacyHash(str){
  let h = 5381;
  for(let i=0;i<str.length;i++){ h = ((h*33) ^ str.charCodeAt(i)) >>> 0; }
  return h.toString(16);
}
async function sha256Hex(str){
  if(window.crypto && crypto.subtle && crypto.subtle.digest){
    try{
      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str));
      return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,"0")).join("");
    }catch(e){ /* fall through to legacy below */ }
  }
  return "legacy:"+legacyHash(str); // tagged so it's never confused with a real sha256 hash
}
function getAuth(){
  try{
    const raw = localStorage.getItem(AUTH_KEY);
    if(raw){ const rec = JSON.parse(raw); if(rec && rec.username && rec.passHash) return rec; }   // damaged record -> re-seed default below
  }catch(e){}
  // first run: seed the default demo credentials with the legacy hash; it will
  // silently upgrade to sha256 the first time someone signs in successfully
  const def = { username:"admin", passHash: legacyHash("ukme@2026"), algo:"legacy" };
  try{ localStorage.setItem(AUTH_KEY, JSON.stringify(def)); }catch(e){}
  return def;
}
async function setAuth(username, plainPass){
  const rec = { username, passHash: await sha256Hex(plainPass), algo:"sha256" };
  try{ localStorage.setItem(AUTH_KEY, JSON.stringify(rec)); }catch(e){}
}
async function verifyAuth(username, plainPass){
  const rec = getAuth();
  if(username.toLowerCase() !== rec.username.toLowerCase()) return false;
  if(rec.algo === "sha256"){
    return (await sha256Hex(plainPass)) === rec.passHash;
  }
  // legacy record: check with the old algorithm, and upgrade on success
  if(legacyHash(plainPass) === rec.passHash){
    await setAuth(rec.username, plainPass);
    return true;
  }
  return false;
}

/* ---- login lockout (slows down repeated guessing in the UI; not a real barrier
   against someone editing the page's JS, but keeps casual retries in check) ---- */
function getLockout(){
  try{ return JSON.parse(localStorage.getItem(LOCKOUT_KEY)) || {fails:0, until:0}; }catch(e){ return {fails:0, until:0}; }
}
function setLockout(rec){ try{ localStorage.setItem(LOCKOUT_KEY, JSON.stringify(rec)); }catch(e){} }
function registerFailedLogin(){
  const rec = getLockout();
  rec.fails = (rec.fails||0) + 1;
  if(rec.fails >= 5){
    const extra = Math.min(rec.fails - 4, 6); // cap the growth
    rec.until = Date.now() + extra*30*1000; // 30s, 60s, 90s ... up to 3 min
  }
  setLockout(rec);
  return rec;
}
function clearLockout(){ setLockout({fails:0, until:0}); }
function lockoutSecondsLeft(){
  const rec = getLockout();
  return Math.max(0, Math.ceil((rec.until - Date.now())/1000));
}

async function showApp(){
  document.getElementById("loginScreen").style.display = "none";
  document.getElementById("appRoot").style.display = "flex";
  await loadState();
  render();
  startInactivityWatch();
}
function showLogin(){
  document.getElementById("loginScreen").style.display = "flex";
  document.getElementById("appRoot").style.display = "none";
  stopInactivityWatch();
}
function logout(){
  try{ sessionStorage.removeItem(AUTH_SESSION_KEY); }catch(e){}
  location.reload();
}

/* ---- auto sign-out after inactivity, for a shared/unattended computer ---- */
let _lastActivity = Date.now();
let _inactivityTimer = null;
function _markActivity(){ _lastActivity = Date.now(); }
function startInactivityWatch(){
  _markActivity();
  ["mousemove","keydown","click","touchstart","scroll"].forEach(ev=>document.addEventListener(ev,_markActivity,{passive:true}));
  stopInactivityWatch();
  _inactivityTimer = setInterval(()=>{
    if(Date.now() - _lastActivity > inactivityLimitMs()) logout();
  }, 15*1000);
}
function stopInactivityWatch(){
  if(_inactivityTimer){ clearInterval(_inactivityTimer); _inactivityTimer=null; }
}

function initAuth(){
  let authed = false;
  try{ authed = sessionStorage.getItem(AUTH_SESSION_KEY) === "1"; }catch(e){}
  if(authed){ showApp().catch(err=>{ console.error(err); try{ sessionStorage.removeItem(AUTH_SESSION_KEY); }catch(e){} location.reload(); }); return; }
  showLogin();
  const form = document.getElementById("loginForm");
  const errBox = document.getElementById("loginError");
  const submitBtn = form.querySelector('button[type="submit"]');
  form.addEventListener("submit", async function(e){
    e.preventDefault();
    const left = lockoutSecondsLeft();
    if(left > 0){
      errBox.textContent = `Too many attempts — try again in ${left}s.`;
      errBox.classList.add("show");
      return;
    }
    submitBtn.disabled = true; const origLabel = submitBtn.textContent; submitBtn.textContent = "Checking...";
    const u = document.getElementById("loginUser").value.trim();
    const p = document.getElementById("loginPass").value;
    let ok = false, checkFailed = false;
    try{ ok = await verifyAuth(u, p); }
    catch(err){ checkFailed = true; errBox.textContent = "Sign-in check failed: " + (err && err.message || err); errBox.classList.add("show"); }
    finally{ submitBtn.disabled = false; submitBtn.textContent = origLabel; }   // the button can never stay stuck on "Checking..."
    if(ok){
      clearLockout();
      try{ sessionStorage.setItem(AUTH_SESSION_KEY, "1"); }catch(e){}
      errBox.textContent = "Incorrect username or password.";
      errBox.classList.remove("show");
      try{ await showApp(); }
      catch(err){                                   // don't leave a blank screen: go back to login and say what broke
        try{ sessionStorage.removeItem(AUTH_SESSION_KEY); }catch(e){}
        showLogin(); console.error(err);
        errBox.textContent = "Signed in, but the app could not load its data: " + (err && err.message || err);
        errBox.classList.add("show");
      }
    }else if(!checkFailed){
      const rec = registerFailedLogin();
      const secs = lockoutSecondsLeft();
      errBox.textContent = secs > 0 ? `Too many attempts — try again in ${secs}s.` : "Incorrect username or password.";
      errBox.classList.add("show");
    }
  });
}

/* ================= HELPERS ================= */
function todayDate(){ const d=new Date(); d.setHours(0,0,0,0); return d; }
function parseDate(s){ const d=new Date(s+"T00:00:00"); return d; }
function fmtDate(s){ if(!s) return "—"; const d=parseDate(s);
  return d.toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"}); }
function daysUntil(dueStr){ const d=parseDate(dueStr); const t=todayDate(); return Math.round((d-t)/86400000); }
function money(cur,val){ return cur + Number(val).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
function round2(n){ return Math.round((Number(n)||0)*100 + (n<0?-1e-9:1e-9))/100; }   // cent-accurate rounding
function lineAmount(it){ return round2((Number(it.qty)||0) * (Number(it.unitPrice)||0)); }
function docTotal(items){ return round2((items||[]).reduce((s,it)=>s+lineAmount(it),0)); }
function effectiveStatus(doc){
  if(doc.status==="paid") return "paid";
  const du = daysUntil(doc.dueDate || doc.deliveryDate);
  if(du<0) return "overdue";
  return "unpaid";
}
function dueFieldOf(doc){ return doc.dueDate || doc.deliveryDate; }
function docNoOf(doc){ return doc.invoiceNo || doc.poNo; }
function isInvoice(doc){ return !!doc.invoiceNo; }
function uid(p){ return p+"-"+Math.random().toString(36).slice(2,9); }
function docDateOf(doc){ return doc._type==="invoice" ? doc.invoiceDate : doc.poDate; }
function partyOf(doc){ return doc._type==="invoice" ? doc.billTo.company : doc.vendor.name; }
/* a document number is treated as "revised" when it ends in the letter A, e.g. PO-2026-006A / UKME/INV/2026/003A */
function isRevised(doc){ return /A$/i.test((docNoOf(doc)||"").trim()); }

/* ================= STATEMENT OF ACCOUNTS ================= */
let statementFilter = { party:"all", period:"this_month", from:"", to:"" };
function pad2(n){ return String(n).padStart(2,"0"); }
function toISO(d){ return d.getFullYear()+"-"+pad2(d.getMonth()+1)+"-"+pad2(d.getDate()); }
function periodRange(period){
  const t = todayDate(); const y=t.getFullYear(), m=t.getMonth();
  const mr=(yr,mo)=>({from:toISO(new Date(yr,mo,1)), to:toISO(new Date(yr,mo+1,0))});
  switch(period){
    case "this_month": return mr(y,m);
    case "last_month": return mr(y,m-1);
    case "last_2_months": return {from:toISO(new Date(y,m-1,1)), to:toISO(new Date(y,m+1,0))};
    case "last_3_months": return {from:toISO(new Date(y,m-2,1)), to:toISO(new Date(y,m+1,0))};
    case "this_quarter": { const qs=m-(m%3); return {from:toISO(new Date(y,qs,1)), to:toISO(new Date(y,qs+3,0))}; }
    case "last_quarter": { const qs=m-(m%3)-3; return {from:toISO(new Date(y,qs,1)), to:toISO(new Date(y,qs+3,0))}; }
    case "last_6_months": return {from:toISO(new Date(y,m-5,1)), to:toISO(new Date(y,m+1,0))};
    case "this_year": return {from:y+"-01-01", to:y+"-12-31"};
    case "last_12_months": return {from:toISO(new Date(y,m-11,1)), to:toISO(new Date(y,m+1,0))};
    case "fiscal_year": { const fm=(Number(settings.advanced.fiscalStartMonth)||1)-1; const sy = m>=fm ? y : y-1; return {from:toISO(new Date(sy,fm,1)), to:toISO(new Date(sy+1,fm,0))}; }
    default: return mr(y,m);
  }
}
function setStatementParty(v){ statementFilter.party=v; render(); }
function setStatementPeriod(v){ statementFilter.period=v; render(); }
function setStatementFrom(v){ statementFilter.from=v; render(); }
function setStatementTo(v){ statementFilter.to=v; render(); }
function sumByCurrency(docs){
  const map={}; docs.forEach(d=>{ map[d.currency]=(map[d.currency]||0)+docTotal(d.items); }); return map;
}
function fmtCurrencyMap(map){
  const keys=Object.keys(map);
  if(!keys.length) return "—";
  return keys.map(c=>money(c,map[c])).join(" &nbsp;+&nbsp; ");
}
function statementData(){
  const clientNames = [...new Set(invoices.map(d=>d.billTo.company))].sort();
  const vendorNames = [...new Set(purchaseOrders.map(d=>d.vendor.name))].sort();
  const range = statementFilter.period==="custom"
    ? {from: statementFilter.from || "0000-01-01", to: statementFilter.to || "9999-12-31"}
    : periodRange(statementFilter.period);

  const docs = allDocs().filter(d=>{
    const dt = docDateOf(d);
    if(!dt || dt < range.from || dt > range.to) return false;
    if(statementFilter.party!=="all" && partyOf(d)!==statementFilter.party) return false;
    return true;
  }).sort((a,b)=> parseDate(docDateOf(a)) - parseDate(docDateOf(b)));

  return {
    clientNames, vendorNames, range, docs,
    invDocs: docs.filter(d=>d._type==="invoice"),
    poDocs: docs.filter(d=>d._type==="po"),
    paidDocs: docs.filter(d=>effectiveStatus(d)==="paid"),
    openDocs: docs.filter(d=>effectiveStatus(d)!=="paid")
  };
}
function renderStatement(){
  const {clientNames, vendorNames, range, docs, invDocs, poDocs, paidDocs, openDocs} = statementData();

  const rows = docs.map(d=>{
    const du = daysUntil(dueFieldOf(d)); const st = effectiveStatus(d);
    return `<tr>
      <td>${fmtDate(docDateOf(d))}</td>
      <td>${d._type==="invoice"?'Invoice (Receivable)':'Purchase Order (Payable)'}</td>
      <td class="mono">${escHtml(docNoOf(d))}${isRevised(d)?' <span class="pill overdue" style="margin-left:4px;">Revised</span>':''}</td>
      <td>${escHtml(partyOf(d))}</td>
      <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
      <td>${statusPill(st,du)}</td>
      <td class="mono">${d.paidDate?fmtDate(d.paidDate):"—"}</td>
    </tr>`;
  }).join("") || `<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:22px 0;">No documents in this period for this selection.</td></tr>`;

  const periodOptions = [
    ["this_month","This month"],["last_month","Last month"],["last_2_months","Last 2 months"],
    ["this_quarter","This quarter (3 months)"],["last_quarter","Last quarter (3 months)"],
    ["last_3_months","Last 3 months"],["last_6_months","Last 6 months"],["this_year","This year"],["custom","Custom range"]
  ].map(([v,l])=>`<option value="${v}" ${statementFilter.period===v?"selected":""}>${l}</option>`).join("");

  const partyOptions = `<option value="all" ${statementFilter.party==="all"?"selected":""}>All clients &amp; vendors</option>`
    + `<optgroup label="Clients (Invoices)">${clientNames.map(n=>`<option value="${escHtml(n)}" ${statementFilter.party===n?"selected":""}>${escHtml(n)}</option>`).join("")}</optgroup>`
    + `<optgroup label="Vendors (Purchase Orders)">${vendorNames.map(n=>`<option value="${escHtml(n)}" ${statementFilter.party===n?"selected":""}>${escHtml(n)}</option>`).join("")}</optgroup>`;

  return `
  <div class="panel"><div class="panel-body pad">
    <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end;">
      <div class="field" style="min-width:260px;flex:1;">
        <label>Client / Vendor</label>
        <select onchange="setStatementParty(this.value)">${partyOptions}</select>
      </div>
      <div class="field" style="min-width:200px;">
        <label>Period</label>
        <select onchange="setStatementPeriod(this.value)">${periodOptions}</select>
      </div>
      ${statementFilter.period==="custom" ? `
      <div class="field"><label>From</label><input type="date" value="${statementFilter.from}" onchange="setStatementFrom(this.value)"></div>
      <div class="field"><label>To</label><input type="date" value="${statementFilter.to}" onchange="setStatementTo(this.value)"></div>
      ` : ``}
    </div>
    <div style="font-size:12px;color:var(--muted);margin-top:2px;">Showing ${fmtDate(range.from)} &ndash; ${fmtDate(range.to)}</div>
  </div></div>

  <div class="cards" style="grid-template-columns:repeat(4,1fr);margin-bottom:18px;">
    <div class="card"><div class="label">Total Invoiced</div><div class="value" style="font-size:16px;">${fmtCurrencyMap(sumByCurrency(invDocs))}</div></div>
    <div class="card"><div class="label">Total Purchase Orders</div><div class="value" style="font-size:16px;">${fmtCurrencyMap(sumByCurrency(poDocs))}</div></div>
    <div class="card"><div class="label">Paid / Settled</div><div class="value" style="font-size:16px;">${fmtCurrencyMap(sumByCurrency(paidDocs))}</div></div>
    <div class="card"><div class="label">Outstanding Balance</div><div class="value" style="font-size:16px;">${fmtCurrencyMap(sumByCurrency(openDocs))}</div></div>
  </div>

  <div class="panel"><div class="panel-head"><h2>Statement detail</h2></div><div class="panel-body">
    <table class="grid"><thead><tr><th>Date</th><th>Type</th><th>Doc No.</th><th>Party</th><th class="right">Amount</th><th>Status</th><th>Paid on</th></tr></thead>
    <tbody>${rows}</tbody></table></div></div>`;
}

/* printable / PDF version of the statement, in the same doc-page frame used for invoices & POs */
function renderStatementDoc(){
  const {range, docs, invDocs, poDocs, paidDocs, openDocs} = statementData();
  const partyLabel = statementFilter.party==="all" ? "All clients &amp; vendors" : escHtml(statementFilter.party);
  const rows = docs.map(d=>{
    const st = effectiveStatus(d);
    return `<tr>
      <td>${fmtDate(docDateOf(d))}</td>
      <td>${d._type==="invoice"?"Invoice":"Purchase Order"}</td>
      <td>${escHtml(docNoOf(d))}${isRevised(d)?" (Revised)":""}</td>
      <td>${escHtml(partyOf(d))}</td>
      <td class="right">${money(d.currency, docTotal(d.items))}</td>
      <td>${st==="paid"?"Paid":(st==="overdue"?"Overdue":"Unpaid")}</td>
      <td>${d.paidDate?fmtDate(d.paidDate):"—"}</td>
    </tr>`;
  }).join("") || `<tr><td colspan="7" style="text-align:center;color:#888;padding:16px 0;">No documents in this period.</td></tr>`;

  return `<div class="doc-page">
    ${docHeader("STATEMENT OF ACCOUNTS")}
    <div class="doc-body">
      <div class="box" style="margin-bottom:16px;">
        <table class="info-strip">
          <tr><td class="label">Statement For</td><td class="val">${partyLabel}</td>
              <td class="label">Period</td><td class="val">${fmtDate(range.from)} &ndash; ${fmtDate(range.to)}</td></tr>
          <tr><td class="label">Total Invoiced</td><td class="val">${fmtCurrencyMap(sumByCurrency(invDocs))}</td>
              <td class="label">Total Purchase Orders</td><td class="val">${fmtCurrencyMap(sumByCurrency(poDocs))}</td></tr>
          <tr><td class="label">Paid / Settled</td><td class="val">${fmtCurrencyMap(sumByCurrency(paidDocs))}</td>
              <td class="label">Outstanding Balance</td><td class="val">${fmtCurrencyMap(sumByCurrency(openDocs))}</td></tr>
        </table>
      </div>
      <table class="grid" style="font-size:12px;">
        <thead><tr><th>Date</th><th>Type</th><th>Doc No.</th><th>Party</th><th class="right">Amount</th><th>Status</th><th>Paid on</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    ${docFooter()}
  </div>`;
}

/* printable / PDF version of the revised-documents list */
function renderRevisedDoc(){
  const docs = allDocs().filter(isRevised).sort((a,b)=> parseDate(docDateOf(b)) - parseDate(docDateOf(a)));
  const rows = docs.map(d=>{
    const st = effectiveStatus(d);
    return `<tr>
      <td>${escHtml(docNoOf(d))}</td>
      <td>${d._type==="invoice"?"Invoice":"Purchase Order"}</td>
      <td>${escHtml(partyOf(d))}</td>
      <td>${fmtDate(docDateOf(d))}</td>
      <td class="right">${money(d.currency, docTotal(d.items))}</td>
      <td>${st==="paid"?"Paid":(st==="overdue"?"Overdue":"Unpaid")}</td>
    </tr>`;
  }).join("") || `<tr><td colspan="6" style="text-align:center;color:#888;padding:16px 0;">No revised documents.</td></tr>`;

  return `<div class="doc-page">
    ${docHeader("REVISED DOCUMENTS")}
    <div class="doc-body">
      <p style="font-size:12px;color:#555;margin:0 0 14px 0;">Invoices and purchase orders whose number ends in the letter "A", generated on ${fmtDate(toISO(new Date()))}.</p>
      <table class="grid" style="font-size:12px;">
        <thead><tr><th>Doc No.</th><th>Type</th><th>Party</th><th>Date</th><th class="right">Amount</th><th>Status</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>
    </div>
    ${docFooter()}
  </div>`;
}

/* ================= PDF ENGINE — real multi-page output =================
   Nothing is ever cut through the middle of a row, box, totals block, signature block or heading.
   - the page is captured once, then sliced ONLY at safe places (between rows / boxes / blocks)
   - the branded header (logo + title bar) and the green contact footer are repeated on every page
   - a table's column-heading row is repeated at the top of every continuation page
   - a heading is never left alone at the bottom of a page; the TOTAL row never sits alone on a new page
   - a document that fits on one page keeps the original single "hugging" page (no blank space)
   Every PDF in the app (invoice, PO, statement, revised list, all "Download PDF" screens) uses this. */
const PDF_A4 = { w:595.28, h:841.89, margin:0 };   // full-bleed: the document fills the whole A4 sheet, no white page margins
const PDF_ATOMS = "tr, .box, .card, .totals-strip, .terms, .sig-row, .thankyou, .qb-widget, .ageing-grid, .bar-row, .recent-row, .empty, .qb-toolbar, .tb-note, .cards, p";
const PDF_HEADINGS = ".panel-head, .section-label, h2, h3, h4, h5, .qb-h";

async function pdfWaitForAssets(node){
  try{ if(document.fonts && document.fonts.ready) await document.fonts.ready; }catch(e){}
  await Promise.all([...node.querySelectorAll("img")].map(im =>
    (im.complete && im.naturalWidth) ? Promise.resolve() : new Promise(res=>{ im.onload = im.onerror = ()=>res(); })));
}
/* last canvas row (searching upward from `to`) that contains any visible ink — so trailing white padding never becomes an empty page */
function pdfLastInkRow(canvas, from, to, edge){
  const g = canvas.getContext("2d"), w = Math.max(1, canvas.width - edge*2), CH = 48;
  for(let y = Math.round(to); y > from; y -= CH){
    const y0 = Math.max(Math.round(from), y - CH), h = y - y0; if(h <= 0) break;
    const d = g.getImageData(edge, y0, w, h).data;
    for(let i = d.length - 4; i >= 0; i -= 4){
      if(d[i] < 246 || d[i+1] < 246 || d[i+2] < 246) return y0 + Math.floor(i/4 / w) + 1;
    }
  }
  return from;
}
function pdfCrop(src, y0, y1){
  const c = document.createElement("canvas");
  c.width = src.width; c.height = Math.max(1, Math.round(y1) - Math.round(y0));
  const g = c.getContext("2d"); g.fillStyle = "#ffffff"; g.fillRect(0,0,c.width,c.height);
  g.drawImage(src, 0, Math.round(y0), src.width, c.height, 0, 0, src.width, c.height);
  return c;
}

/* renders one .doc-page node (already attached to the page, may be off-screen) into a paginated A4 PDF and saves it.
   FULL-BLEED A4: no white page margins — the green title bar, the document and the green contact bar run edge to edge.
   - a document shorter than A4 is stretched to the full sheet height (contact bar pinned to the bottom edge)
   - an invoice / PO that is a little too tall for one sheet is laid out slightly WIDER (same look, text just proportionally
     smaller when scaled to the sheet) until its height/width matches A4, so it still fills the sheet edge to edge
   - anything longer is paginated on A4, header + footer repeated on every page, nothing cut through a row/box */
async function downloadReportPDF(node, filename, opts){
  opts = opts || {};
  await pdfWaitForAssets(node);
  const A = PDF_A4, ratio = A.h / A.w;
  const ft = node.querySelector(":scope > .doc-footer");
  const keys = ["width","minHeight","display","flexDirection","border","borderRadius","boxShadow"];
  const saved = {}; keys.forEach(k => saved[k] = node.style[k]);
  const ftMT = ft ? ft.style.marginTop : "";
  const grown = [];
  const restore = () => { keys.forEach(k => { node.style[k] = saved[k]; }); if(ft) ft.style.marginTop = ftMT; grown.forEach(([el,k]) => { el.style[k] = ""; }); };
  try{
    node.style.border = "none"; node.style.borderRadius = "0"; node.style.boxShadow = "none";   // the on-screen card frame must not appear in the PDF
    // Lay the document out 6 % wider than its on-screen width (900 -> ~958 px): once it fills the full sheet width the
    // text keeps exactly the physical size it had in the earlier margin version, and page breaks fall in the same places.
    const W0 = Math.round(node.getBoundingClientRect().width * A.w / (A.w - 36));
    const heightAt = w => { node.style.width = w + "px"; node.style.minHeight = ""; return node.getBoundingClientRect().height; };
    const fits = w => heightAt(w) <= Math.floor(w * ratio);
    let W = W0;
    if(opts.fitOnePage && !fits(W0)){
      const MAXW = Math.round(W0 / 0.70);                                  // never shrink the content below 70 %
      if(fits(MAXW)){
        let lo = W0, hi = MAXW;
        for(let i=0; i<14; i++){ const mid = (lo+hi)/2; if(fits(mid)) hi = mid; else lo = mid; }
        W = Math.min(MAXW, Math.ceil(hi)); while(!fits(W) && W < MAXW) W++;
      }
    }
    node.style.width = W + "px"; node.style.minHeight = "";
    const fullH = Math.floor(W * ratio);
    if(ft && node.getBoundingClientRect().height < fullH){
      // Purchase Order: hand the spare sheet height to the Terms box and the signature / stamp boxes (instead of leaving
      // an empty band above the green footer), so the page looks full and balanced.
      if(node.classList.contains("po-doc")){
        // spare sheet height: all of it is spread as even gaps between the sections,
        // so the signature / stamp boxes keep their original size and the Terms box is larger - no empty band above the footer.
        const spare = fullH - node.getBoundingClientRect().height;
        const body = node.querySelector(".doc-body");
        if(body){ ["flex","display","flexDirection","justifyContent"].forEach(k => grown.push([body,k])); body.style.flex = "1 1 auto"; body.style.display = "flex"; body.style.flexDirection = "column"; body.style.justifyContent = "space-between"; }
      }
      node.style.minHeight = fullH + "px"; node.style.display = "flex"; node.style.flexDirection = "column"; ft.style.marginTop = "auto";
    }
    await pdfRenderCore(node, filename, opts);
  } finally { restore(); }
}

async function pdfRenderCore(node, filename, opts){
  const nRect = node.getBoundingClientRect(), H = nRect.height, top0 = nRect.top;
  const SCALE = Math.max(1, Math.min(2, 30000 / H));          // very long documents: lower the scale so the canvas stays within browser limits
  const canvas = await html2canvas(node, { scale:SCALE, backgroundColor:"#ffffff", useCORS:true, logging:false });
  const f = canvas.height / H;                                 // CSS px -> canvas px
  const rel = el => { const r = el.getBoundingClientRect(); return { top:(r.top-top0)*f, bottom:(r.bottom-top0)*f }; };
  const { jsPDF } = window.jspdf;
  const A = PDF_A4, contentW = A.w - A.margin*2, q = contentW / canvas.width;   // q = pt per canvas px

  // regions: header (logo + title bar) | body | footer (contact bar)
  const tb = node.querySelector(".doc-titlebar"), hd = node.querySelector(".doc-header"), ft = node.querySelector(".doc-footer");
  const headBottom = Math.round(tb ? rel(tb).bottom : (hd ? rel(hd).bottom : 0));
  const footTop = Math.round(ft ? rel(ft).top : canvas.height);
  const headerC = headBottom > 0 ? pdfCrop(canvas, 0, headBottom) : null;
  const footerC = ft ? pdfCrop(canvas, footTop, canvas.height) : null;

  // ---- single page: the whole document fits on one A4 sheet -> full-bleed A4 (595.28 x 841.89 pt), edge to edge
  if(canvas.height*q <= A.h + 2){
    const pdf = new jsPDF({ unit:"pt", format:"a4" });
    const ch = canvas.height*q;
    if(Math.abs(ch - A.h) <= 3 || !(footerC && footTop > 0)){
      pdf.addImage(canvas.toDataURL("image/png"), "PNG", 0, 0, A.w, Math.abs(ch - A.h) <= 3 ? A.h : ch, undefined, "FAST");
    } else {
      const bodyC = pdfCrop(canvas, 0, footTop), footH = footerC.height*q;
      pdf.addImage(bodyC.toDataURL("image/png"), "PNG", 0, 0, A.w, bodyC.height*q, undefined, "FAST");
      pdf.addImage(footerC.toDataURL("image/png"), "PNG", 0, A.h - footH, A.w, footH, undefined, "FAST");
    }
    pdf.save(filename); return;
  }

  // ---- multi page: collect every place where a page must NOT be cut
  const isAtomEl = el => el.matches && el.matches(PDF_ATOMS);
  const atoms = [...node.querySelectorAll(PDF_ATOMS)]
    .map(el => Object.assign({el}, rel(el)))
    .filter(z => z.bottom - z.top > 1 && z.bottom > headBottom && z.top < footTop)
    .sort((a,b)=>a.top-b.top);
  const zones = atoms.slice();
  const tables = [];
  node.querySelectorAll("table").forEach(t=>{
    const th = t.tHead, tf = t.tFoot, rows = [...t.tBodies].flatMap(b=>[...b.rows]);
    if(th && th.rows.length && rows.length){
      const hr = rel(th);
      zones.push({ top:hr.top, bottom:rel(rows[0]).bottom });                       // column heading + first row stay together
      tables.push({ hTop:hr.top, hBottom:hr.bottom, bottom:rel(t).bottom });
    }
    if(tf && tf.rows.length && rows.length) zones.push({ top:rel(rows[rows.length-1]).top, bottom:rel(tf).bottom });   // last row + TOTAL row stay together
  });
  node.querySelectorAll(PDF_HEADINGS).forEach(h=>{
    if(h.parentElement && h.parentElement.closest(PDF_ATOMS)) return;               // heading already inside an unbreakable block
    const hr = rel(h);
    const next = atoms.find(a => a.top >= hr.bottom - 3 && !a.el.contains(h) && !h.contains(a.el));
    if(next) zones.push({ top:hr.top, bottom:next.bottom });                        // heading stays with what follows it
  });

  const edge = Math.max(1, Math.round(f));                                          // the 1px page border, redrawn so it runs the full page height
  // (the scan stops a few rows above the footer, so the footer's own anti-aliased top edge is never mistaken for page content)
  const contentEnd = Math.min(footTop, pdfLastInkRow(canvas, headBottom, footTop - Math.round(4*f), edge + 2) + Math.round(3*f));
  const gapC = Math.round(14*f), footGapC = Math.round(8*f), minKeep = Math.round(24*f);
  const pageHc = Math.floor((A.h - A.margin*2) / q);                                // full A4 page height in canvas px
  node.querySelectorAll(".panel").forEach(el=>{ const r = rel(el); if(r.bottom - r.top < pageHc*0.45 && r.bottom > headBottom && r.top < footTop) zones.push(r); });   // a small panel/card is never split (large table panels can be, row by row)
  const fixedC = (headerC?headerC.height:0) + (footerC?footerC.height:0) + footGapC;
  const theadAt = pos => {                                                          // table whose heading row must repeat on the page starting at pos
    let best = null;
    tables.forEach(t=>{ if(t.hBottom <= pos+1 && pos < t.bottom-2 && (!best || t.hTop > best.hTop)) best = t; });
    return best;
  };
  const chooseCut = (pos, limit, avail) => {
    let cut = limit;
    for(let n=0; n<100; n++){
      let moved = false;
      for(const z of zones){
        if(z.top < cut-3 && z.bottom > cut+3 && z.top > pos+minKeep && (z.bottom - z.top) <= avail*0.98){ cut = Math.floor(z.top) - 1; moved = true; }   // 1px above the block, so its top border is never sliced
      }
      if(!moved) break;
    }
    return cut;
  };

  const pages = [];
  let pos = headBottom;
  while(pos < contentEnd - 2){
    const cont = pages.length > 0;
    const th = cont ? theadAt(pos) : null;
    const thC = (th && (th.hBottom - th.hTop) < pageHc*0.25) ? pdfCrop(canvas, th.hTop, th.hBottom) : null;
    const avail = pageHc - fixedC - (cont ? gapC : 0) - (thC ? thC.height : 0);
    const limit = pos + avail;
    let cut = (contentEnd <= limit + footGapC) ? contentEnd : chooseCut(pos, limit, avail);   // the small gap above the footer may be used up rather than starting a page for a few pixels
    if(cut <= pos + 2) cut = Math.min(limit, contentEnd);                              // safety: always make progress
    pages.push({ from:pos, to:cut, cont, thC });
    pos = cut;
  }

  const pdf = new jsPDF({ unit:"pt", format:"a4" });
  pages.forEach((p, i)=>{
    const pc = document.createElement("canvas"); pc.width = canvas.width; pc.height = pageHc;
    const g = pc.getContext("2d"); g.fillStyle = "#ffffff"; g.fillRect(0,0,pc.width,pc.height);
    let y = 0;
    if(headerC){ g.drawImage(headerC, 0, 0); y = headerC.height; }
    if(p.cont) y += gapC;
    if(p.thC){ g.drawImage(p.thC, 0, y); y += p.thC.height; }
    g.drawImage(pdfCrop(canvas, p.from, p.to), 0, y);
    if(footerC) g.drawImage(footerC, 0, pc.height - footerC.height);
    if(i>0) pdf.addPage();
    pdf.addImage(pc.toDataURL("image/png"), "PNG", 0, 0, A.w, A.h, undefined, "FAST");
  });
  const fhPt = footerC ? footerC.height*q : 0;
  pdf.setFontSize(7); pdf.setTextColor(footerC ? 214 : 120, footerC ? 230 : 120, footerC ? 222 : 120);
  for(let i=1; i<=pages.length; i++){
    pdf.setPage(i);
    if(footerC) pdf.text("Page "+i+" of "+pages.length, A.w-16, A.h - fhPt/2 + 2.4, { align:"right" });      // inside the green contact bar
    else pdf.text("Page "+i+" of "+pages.length, A.w/2, A.h-7, { align:"center" });
  }
  pdf.save(filename);
}

/* copy a screen/doc node off-screen (canvases become images, so charts survive), run the PDF engine, clean up */
async function exportNodePDF(sourceNode, filename, opts){
  const wrap = document.createElement("div");
  wrap.style.position = "fixed"; wrap.style.left = "-99999px"; wrap.style.top = "0";
  const clone = sourceNode.cloneNode(true);
  const srcCanvases = sourceNode.querySelectorAll("canvas"), dstCanvases = clone.querySelectorAll("canvas");
  dstCanvases.forEach((c,i)=>{ const s = srcCanvases[i]; if(!s) return; try{ const im = document.createElement("img"); im.src = s.toDataURL("image/png"); im.style.width = "100%"; im.style.height = "100%"; im.style.objectFit = "contain"; im.style.display = "block"; c.replaceWith(im); }catch(e){} });
  wrap.appendChild(clone); document.body.appendChild(wrap);
  try{ await downloadReportPDF(clone, filename, opts); }
  finally{ document.body.removeChild(wrap); }
}

function buildOffscreenReport(html){
  const wrap = document.createElement("div");
  wrap.style.position = "fixed"; wrap.style.left = "-99999px"; wrap.style.top = "0";
  wrap.innerHTML = html;
  document.body.appendChild(wrap);
  return wrap;
}
async function exportStatementPDF(){
  const btn = document.querySelector('#topActions .btn');
  const original = btn ? btn.textContent : null;
  if(btn) btn.textContent = "Preparing...";
  const wrap = buildOffscreenReport(renderStatementDoc());
  try{
    const party = statementFilter.party==="all" ? "All" : statementFilter.party.replace(/[^a-z0-9]+/gi,"-");
    await downloadReportPDF(wrap.querySelector(".doc-page"), `UKME-Statement-of-Accounts-${party}.pdf`);
  }catch(e){ alert("Could not generate PDF: "+e.message); }
  document.body.removeChild(wrap);
  if(btn) btn.textContent = original;
}
async function exportRevisedPDF(){
  const btn = document.querySelector('#topActions .btn');
  const original = btn ? btn.textContent : null;
  if(btn) btn.textContent = "Preparing...";
  const wrap = buildOffscreenReport(renderRevisedDoc());
  try{
    await downloadReportPDF(wrap.querySelector(".doc-page"), "UKME-Revised-Documents.pdf");
  }catch(e){ alert("Could not generate PDF: "+e.message); }
  document.body.removeChild(wrap);
  if(btn) btn.textContent = original;
}

/* generic "Download PDF" for any screen that doesn't already have its own export
   (dashboard, receivable, payable, payments, chart of accounts, trial balance,
   clients & vendors, and the invoice/PO lists) — wraps the current on-screen
   content in the same branded header/footer used for the other reports, strips
   interactive controls (buttons/inputs) before capture, and reuses the existing
   multi-page PDF capture so nothing gets cut off. */
async function exportCurrentViewPDF(){
  const btn = document.getElementById("genPdfBtn");
  const original = btn ? btn.textContent : null;
  if(btn){ btn.disabled = true; btn.textContent = "Preparing..."; }
  const content = document.getElementById("content");
  const [title, subtitle] = titles[currentView] || ["Report",""];
  // clone the live screen (not innerHTML) so chart canvases can be turned into pictures instead of coming out blank
  const body = content.cloneNode(true);
  body.removeAttribute("id");
  const srcCanvases = content.querySelectorAll("canvas");
  body.querySelectorAll("canvas").forEach((c,i)=>{
    const s = srcCanvases[i]; if(!s) return;
    try{ const im = document.createElement("img"); im.src = s.toDataURL("image/png"); im.style.width = "100%"; im.style.height = "100%"; im.style.objectFit = "contain"; im.style.display = "block"; c.replaceWith(im); }catch(e){}
  });
  body.querySelectorAll("button, input, select, .file-btn").forEach(el=>el.remove());
  const wrap = buildOffscreenReport(`
    <div class="doc-page">
      ${docHeader(escHtml(title.toUpperCase()))}
      <div class="doc-body">
        <p style="font-size:12px;color:#555;margin:0 0 16px 0;">${escHtml(subtitle)} — generated ${fmtDate(toISO(new Date()))}</p>
        <div id="pdfContentSlot"></div>
      </div>
      ${docFooter()}
    </div>`);
  wrap.querySelector("#pdfContentSlot").replaceWith(...body.childNodes);
  try{
    const fname = "UKME-" + title.replace(/[^a-z0-9]+/gi,"-") + "-" + toISO(new Date()) + ".pdf";
    await downloadReportPDF(wrap.querySelector(".doc-page"), fname);
  }catch(e){ alert("Could not generate PDF: "+e.message); }
  document.body.removeChild(wrap);
  if(btn){ btn.disabled = false; btn.textContent = original; }
}

/* ================= REVISED DOCUMENTS ================= */
function renderRevised(){
  const docs = allDocs().filter(isRevised).sort((a,b)=> parseDate(docDateOf(b)) - parseDate(docDateOf(a)));
  const rows = docs.map(d=>{
    const du = daysUntil(dueFieldOf(d)); const st = effectiveStatus(d);
    return `<tr>
      <td class="mono">${escHtml(docNoOf(d))}</td>
      <td>${d._type==="invoice"?"Invoice":"Purchase Order"}</td>
      <td>${escHtml(partyOf(d))}</td>
      <td class="mono">${fmtDate(docDateOf(d))}</td>
      <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
      <td>${statusPill(st,du)}</td>
      <td class="right"><button class="icon-btn" onclick="previewDoc('${d._type}','${d.id}')">View</button><button class="icon-btn" onclick="editDoc('${d._type}','${d.id}')">Edit</button></td>
    </tr>`;
  }).join("") || `<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:22px 0;">No revised documents yet. A document counts as revised when its number ends in the letter A (e.g. PO-2026-006A).</td></tr>`;
  return `<div class="panel"><div class="panel-head"><h2>Documents ending in "A" (revised versions)</h2></div><div class="panel-body">
    <table class="grid"><thead><tr><th>Doc No.</th><th>Type</th><th>Party</th><th>Date</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead>
    <tbody>${rows}</tbody></table></div></div>`;
}

function reminderDays(){ return Math.max(0, Number(settings.payments.reminderDays)); }
function statusPill(st, du){
  if(st==="paid") return '<span class="pill paid">Paid</span>';
  if(st==="overdue") return '<span class="pill overdue">Overdue '+Math.abs(du)+'d</span>';
  if(du<=reminderDays()) return '<span class="pill reminder">Due in '+du+'d</span>';
  return '<span class="pill unpaid">Due in '+du+'d</span>';
}

function allDocs(){
  return [...invoices.map(d=>({...d,_type:"invoice"})), ...purchaseOrders.map(d=>({...d,_type:"po"}))];
}

/* ================= NAV ICONS, "+ New" MENU, BRANDING ================= */
const NAV_ICONS = {
  dashboard:'<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  invoices:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  receivable:'<circle cx="12" cy="12" r="10"/><polyline points="8 12 12 16 16 12"/><line x1="12" y1="8" x2="12" y2="16"/>',
  pos:'<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
  payable:'<circle cx="12" cy="12" r="10"/><polyline points="16 12 12 8 8 12"/><line x1="12" y1="16" x2="12" y2="8"/>',
  payments:'<rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>',
  statement:'<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>',
  revised:'<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  trialbalance:'<path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/>',
  coa:'<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  vendors:'<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  settings:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>'
};
function initNavIcons(){
  document.querySelectorAll("#navList button[data-view]").forEach(b=>{
    if(b.querySelector(".ico")) return;
    const label = b.textContent.trim();
    const paths = NAV_ICONS[b.dataset.view] || "";
    b.innerHTML = '<span class="ico"><svg viewBox="0 0 24 24">'+paths+'</svg></span><span class="lbl">'+label+'</span>';
  });
}
function toggleNewMenu(e){ if(e) e.stopPropagation(); document.getElementById("newMenu").classList.toggle("show"); }
function closeNewMenu(){ const m=document.getElementById("newMenu"); if(m) m.classList.remove("show"); }
function newMenuGo(what){
  closeNewMenu();
  if(what==="invoice") openInvoiceForm();
  else if(what==="po") openPOForm();
  else if(what==="account"){ switchView("coa"); openAccountForm(); }
}
document.addEventListener("click", closeNewMenu);
function applyBranding(){
  const parts = String(COMPANY.name||"").trim().split(/\s+/);
  const first = parts.shift() || "";
  const set = (id, html)=>{ const el=document.getElementById(id); if(el) el.innerHTML = html; };
  set("brandName", escHtml(first));
  set("brandSub", escHtml(parts.join(" ").toUpperCase()));
  set("sidebarAddr", COMPANY.addressLines.map(escHtml).join("<br>") + (COMPANY.regNo ? "<br>Reg No. "+escHtml(COMPANY.regNo) : ""));
  set("loginTitle", escHtml(COMPANY.name));
  document.title = COMPANY.name + " — Accounts & Documents";
}
initNavIcons();

/* ================= NAVIGATION ================= */
let currentView = "dashboard";
const titles = {
  dashboard:["Dashboard","Business overview — sales, purchases, receivables, payables and reminders"],
  invoices:["Invoices","Sales invoices issued to buyers"],
  pos:["Purchase Orders","Orders placed with vendors and suppliers"],
  receivable:["Accounts Receivable","Money owed to UKME by customers, with ageing"],
  payable:["Accounts Payable","Money UKME owes to vendors, with ageing"],
  payments:["Payment Tracker","All money in and money out, with due-date reminders"],
  statement:["Statement of Accounts","Invoices & purchase orders for a client/vendor over a period — monthly, quarterly and beyond"],
  revised:["Revised Documents","Invoices and purchase orders whose number ends in \"A\" — i.e. revised versions"],
  coa:["Chart of Accounts","Ledger accounts — automatic balances plus your own"],
  trialbalance:["Trial Balance","Debits and credits across all ledger accounts"],
  vendors:["Clients & Vendors","Everyone UKME trades with"],
  settings:["Settings","Company, sales, expenses, payments and advanced settings"]
};

function switchView(v){
  currentView = v;
  document.querySelectorAll("#navList button").forEach(b=>b.classList.toggle("active", b.dataset.view===v));
  document.getElementById("viewTitle").textContent = titles[v][0];
  document.getElementById("viewSub").textContent = titles[v][1];
  render();
}
document.getElementById("navList").addEventListener("click", e=>{
  const b = e.target.closest("button[data-view]");
  if(b) switchView(b.dataset.view);
});

/* Older / hand-edited / imported records can miss fields (blank company, no items...). Fill safe defaults so no page crashes. */
function normalizeRecords(){
  invoices.forEach(d=>{
    if(!d.billTo || typeof d.billTo!=="object") d.billTo = {};
    if(!d.billTo.company) d.billTo.company = "—";
    if(!d.shipping || typeof d.shipping!=="object") d.shipping = {};
    if(!Array.isArray(d.items)) d.items = [];
    if(!d.currency) d.currency = "£";
    if(!d.status) d.status = "unpaid";
  });
  purchaseOrders.forEach(d=>{
    if(!d.vendor || typeof d.vendor!=="object") d.vendor = {};
    if(!d.vendor.name) d.vendor.name = "—";
    if(!Array.isArray(d.items)) d.items = [];
    if(!d.currency) d.currency = "$";
    if(!d.status) d.status = "unpaid";
  });
}
function render(){
  normalizeRecords();
  applyBranding();
  const c = document.getElementById("content");
  const top = document.getElementById("topActions");
  top.innerHTML = "";
  if(currentView==="dashboard") { c.innerHTML = renderDashboard(); }
  else if(currentView==="invoices"){ c.innerHTML = renderInvoiceList(); top.innerHTML = '<button class="btn" onclick="openInvoiceForm()">+ New Invoice</button>'; }
  else if(currentView==="pos"){ c.innerHTML = renderPOList(); top.innerHTML = '<button class="btn" onclick="openPOForm()">+ New Purchase Order</button>'; }
  else if(currentView==="receivable"){ c.innerHTML = renderReceivable(); }
  else if(currentView==="payable"){ c.innerHTML = renderPayable(); }
  else if(currentView==="payments"){ c.innerHTML = renderPayments(); }
  else if(currentView==="statement"){ c.innerHTML = renderStatement(); top.innerHTML = '<button class="btn" onclick="exportStatementPDF()">Download PDF</button>'; }
  else if(currentView==="revised"){ c.innerHTML = renderRevised(); top.innerHTML = '<button class="btn" onclick="exportRevisedPDF()">Download PDF</button>'; }
  else if(currentView==="coa"){ c.innerHTML = renderChartOfAccounts(); top.innerHTML = '<button class="btn" onclick="openAccountForm()">+ New Account</button>'; }
  else if(currentView==="trialbalance"){ c.innerHTML = renderTrialBalance(); }
  else if(currentView==="vendors"){ c.innerHTML = renderVendors(); }
  else if(currentView==="settings"){ c.innerHTML = renderSettings(); }

  // every screen except Settings (nothing to export) and Statement/Revised
  // (already have their own branded export button above) gets a generic PDF button
  if(!["statement","revised","settings"].includes(currentView)){
    const pdfBtn = document.createElement("button");
    pdfBtn.className = "btn ghost small";
    pdfBtn.id = "genPdfBtn";
    pdfBtn.textContent = "Download PDF";
    pdfBtn.onclick = exportCurrentViewPDF;
    top.appendChild(pdfBtn);
  }

  if(currentView==="dashboard") renderDashboardCharts();
}

/* ================= DASHBOARD (QuickBooks-style "Business overview") ================= */
let dashPeriod = "this_month";
function setDashPeriod(v){ dashPeriod = v; render(); }
const DASH_PERIODS = [
  ["this_month","This month"],["last_month","Last month"],["this_quarter","This quarter"],["last_quarter","Last quarter"],
  ["fiscal_year","This fiscal year"],["last_12_months","Last 12 months"],["this_year","This calendar year"]
];
function prevRange(r){
  const from = parseDate(r.from), to = parseDate(r.to);
  const len = Math.round((to-from)/86400000) + 1;
  const pTo = new Date(from); pTo.setDate(pTo.getDate()-1);
  const pFrom = new Date(pTo); pFrom.setDate(pFrom.getDate()-(len-1));
  return { from:toISO(pFrom), to:toISO(pTo) };
}
function sumInRange(list, dateKey, r){
  return list.filter(d=>d[dateKey] && d[dateKey]>=r.from && d[dateKey]<=r.to).reduce((s,d)=>s+docTotal(d.items),0);
}
function changeBadge(cur, prev, upIsGood){
  if(!prev && !cur) return '<span class="chg flat">— no change</span>';
  if(!prev) return '<span class="chg flat">new</span>';
  const pct = ((cur-prev)/prev)*100;
  if(Math.abs(pct) < 0.5) return '<span class="chg flat">— 0%</span>';
  const up = pct > 0;
  const cls = upIsGood===null ? "flat" : (up===upIsGood ? "up" : "down");
  return `<span class="chg ${cls}">${up?"▲":"▼"} ${Math.abs(pct).toFixed(0)}%</span>`;
}
function segBar(parts){
  const total = parts.reduce((s,p)=>s+p.v,0);
  if(!total) return '<div class="seg-bar"><span style="width:100%;background:#e4e6ea"></span></div>';
  return '<div class="seg-bar">' + parts.map(p=>`<span style="width:${(p.v/total*100).toFixed(2)}%;background:${p.color}"></span>`).join("") + '</div>';
}
function fmtMoneyShort(cur, v){ return cur + Number(v).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}); }
function qbWidget(title, body, cls, right){
  return `<div class="qb-widget ${cls||""}"><div class="qb-w-head"><h3>${title}</h3>${right||""}</div><div class="qb-w-body">${body}</div></div>`;
}
function statusWidget(kind){
  const isInv = kind==="invoice";
  const list = isInv ? invoices : purchaseOrders;
  const cur = isInv ? "£" : "$";
  const dueKey = isInv ? "dueDate" : "dueDate";
  const open = list.filter(d=>effectiveStatus(d)!=="paid");
  const overdue = open.filter(d=>effectiveStatus(d)==="overdue");
  const notDue = open.filter(d=>effectiveStatus(d)!=="overdue");
  const sum = a => a.reduce((s,d)=>s+docTotal(d.items),0);
  const paid30 = list.filter(d=>d.status==="paid" && d.paidDate && daysUntil(d.paidDate)>=-30 && daysUntil(d.paidDate)<=0);
  const paid30Sum = sum(paid30);
  return qbWidget(isInv ? "Invoices" : "Purchase orders", `
    <div class="qb-big">${fmtMoneyShort(cur,sum(open))}</div>
    <div class="qb-lab">${open.length} unpaid ${isInv?"invoice":"purchase order"}${open.length===1?"":"s"}</div>
    ${segBar([{v:sum(overdue),color:"#ff8000"},{v:sum(notDue),color:"#babec5"}])}
    <div class="seg-legend">
      <div><i style="background:#ff8000"></i>Overdue<b>${fmtMoneyShort(cur,sum(overdue))}</b></div>
      <div style="text-align:right"><i style="background:#babec5"></i>Not due yet<b>${fmtMoneyShort(cur,sum(notDue))}</b></div>
    </div>
    <div class="qb-divider"></div>
    <div class="qb-big" style="font-size:24px">${fmtMoneyShort(cur,paid30Sum)}</div>
    <div class="qb-lab">${paid30.length} marked paid in the last 30 days</div>
    ${segBar([{v:paid30Sum,color:"#2CA01C"}])}
  `, "", `<button class="qb-link" onclick="switchView('${isInv?"invoices":"pos"}')">View all</button>`);
}
function renderDashboard(){
  const range = periodRange(dashPeriod);
  const prev = prevRange(range);
  const salesNow = sumInRange(invoices,"invoiceDate",range), salesPrev = sumInRange(invoices,"invoiceDate",prev);
  const purNow = sumInRange(purchaseOrders,"poDate",range), purPrev = sumInRange(purchaseOrders,"poDate",prev);
  const periodLabel = (DASH_PERIODS.find(p=>p[0]===dashPeriod)||[])[1] || "This month";

  const recv = invoices.filter(d=>effectiveStatus(d)!=="paid").reduce((s,d)=>s+docTotal(d.items),0);
  const payb = purchaseOrders.filter(d=>effectiveStatus(d)!=="paid").reduce((s,d)=>s+docTotal(d.items),0);
  const overdue = allDocs().filter(d=>effectiveStatus(d)==="overdue");
  const dueSoon = allDocs().filter(d=>{ const st=effectiveStatus(d); const du=daysUntil(dueFieldOf(d)); return st==="unpaid" && du>=0 && du<=reminderDays(); });
  const reminders = [...overdue, ...dueSoon].sort((a,b)=> daysUntil(dueFieldOf(a)) - daysUntil(dueFieldOf(b)));

  // top customers in the period
  const byCust = {};
  invoices.filter(d=>d.invoiceDate>=range.from && d.invoiceDate<=range.to).forEach(d=>{ byCust[d.billTo.company]=(byCust[d.billTo.company]||0)+docTotal(d.items); });
  const topCust = Object.entries(byCust).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const maxCust = topCust.length ? topCust[0][1] : 0;
  const custHtml = topCust.length ? topCust.map(([n,v])=>`<div class="bar-row"><div class="nm" title="${escHtml(n)}">${escHtml(n)}</div><div class="track"><span style="width:${maxCust?(v/maxCust*100).toFixed(1):0}%"></span></div><div class="amt">${fmtMoneyShort("£",v)}</div></div>`).join("") : '<div class="empty" style="padding:24px 0;">No invoices in this period.</div>';

  const rows = reminders.map(d=>{
    const du = daysUntil(dueFieldOf(d)); const st = effectiveStatus(d);
    return `<tr>
      <td>${d._type==="invoice"?'<span class="pill paid">Receivable</span>':'<span class="pill unpaid">Payable</span>'}</td>
      <td class="mono">${escHtml(docNoOf(d))}</td>
      <td>${escHtml(partyOf(d))}</td>
      <td class="mono">${fmtDate(dueFieldOf(d))}</td>
      <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
      <td>${statusPill(st,du)}</td>
      <td class="right">
        <button class="icon-btn" onclick="previewDoc('${d._type}','${d.id}')">View</button>
        <button class="icon-btn" onclick="editDoc('${d._type}','${d.id}')">Edit</button>
        <button class="icon-btn" onclick="markPaid('${d._type}','${d.id}')">Mark paid</button>
      </td>
    </tr>`;
  }).join("");

  const recentInv = [...invoices].sort((a,b)=>b.invoiceDate.localeCompare(a.invoiceDate)).slice(0,5);
  const recentPo = [...purchaseOrders].sort((a,b)=>b.poDate.localeCompare(a.poDate)).slice(0,5);
  const recentRow = (no, party, amt, pill, type, id) => `<div class="recent-row" onclick="previewDoc('${type}','${id}')"><span><b class="mono">${escHtml(no)}</b><small>${escHtml(party)}</small></span><span class="r">${amt}<br>${pill}</span></div>`;

  return `
  <div class="qb-toolbar">
    <div><h2 class="qb-h">Business overview</h2><div class="qb-sub">${escHtml(COMPANY.name)} — ${fmtDate(range.from)} to ${fmtDate(range.to)}</div></div>
    <div class="qb-period"><label>Period</label>
      <select onchange="setDashPeriod(this.value)">${DASH_PERIODS.map(p=>`<option value="${p[0]}" ${p[0]===dashPeriod?"selected":""}>${p[1]}</option>`).join("")}</select>
    </div>
  </div>

  <div class="cards">
    <div class="card"><div class="label">Open receivable</div><div class="value">${fmtMoneyShort("£",recv)}</div><div class="foot">${invoices.filter(d=>effectiveStatus(d)!=="paid").length} unpaid invoice(s)</div></div>
    <div class="card gold"><div class="label">Open payable</div><div class="value">${fmtMoneyShort("$",payb)}</div><div class="foot">${purchaseOrders.filter(d=>effectiveStatus(d)!=="paid").length} unpaid PO(s)</div></div>
    <div class="card amber"><div class="label">Due within ${reminderDays()} day${reminderDays()===1?"":"s"}</div><div class="value amber">${dueSoon.length}</div><div class="foot">Reminder window (Settings → Payments)</div></div>
    <div class="card red"><div class="label">Overdue</div><div class="value red">${overdue.length}</div><div class="foot">Needs immediate follow-up</div></div>
  </div>

  <div class="qb-grid">
    ${qbWidget("Sales &amp; purchases", `
      <div class="qb-lab">${periodLabel} — invoiced</div>
      <div class="qb-big">${fmtMoneyShort("£",salesNow)}${changeBadge(salesNow,salesPrev,true)}</div>
      <div class="qb-lab">vs ${fmtMoneyShort("£",salesPrev)} in the previous period</div>
      <div class="qb-divider"></div>
      <div class="qb-lab">${periodLabel} — purchase orders raised</div>
      <div class="qb-big">${fmtMoneyShort("$",purNow)}${changeBadge(purNow,purPrev,null)}</div>
      <div class="qb-lab">vs ${fmtMoneyShort("$",purPrev)} in the previous period</div>
      <div class="qb-note">Invoices are in £ and purchase orders in $, so they aren't netted into a single profit figure.</div>
    `)}
    ${statusWidget("invoice")}
    ${statusWidget("po")}
    ${qbWidget("Sales — last 6 months", `<div class="chart-wrap"><canvas id="chartSales"></canvas></div>`, "span2")}
    ${qbWidget("Top customers", custHtml)}
    ${qbWidget("Expenses by vendor", `<div class="chart-wrap"><canvas id="chartExpenses"></canvas></div>`)}
    ${qbWidget("Cash flow — last 6 months", `<div class="chart-wrap"><canvas id="chartCash"></canvas></div><div class="qb-note">Money in = invoices marked paid (£). Money out = purchase orders marked paid ($). Grouped by the paid date.</div>`, "span2")}
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Payment reminders — due within ${reminderDays()} day${reminderDays()===1?"":"s"} or overdue</h2></div>
    <div class="panel-body">
      ${rows ? `<table class="grid"><thead><tr><th>Type</th><th>Doc No.</th><th>Party</th><th>Due date</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead><tbody>${rows}</tbody></table>` : '<div class="empty">Nothing due soon. All caught up.</div>'}
    </div>
  </div>

  <div class="qb-grid two">
    <div class="panel" style="margin:0"><div class="panel-head"><h2>Recent invoices</h2><button class="btn ghost small" onclick="switchView('invoices')">View all</button></div>
      <div class="panel-body">${recentInv.map(d=>recentRow(d.invoiceNo,d.billTo.company,money(d.currency,docTotal(d.items)),statusPill(effectiveStatus(d),daysUntil(d.dueDate)),"invoice",d.id)).join("") || '<div class="empty">No invoices yet.</div>'}</div></div>
    <div class="panel" style="margin:0"><div class="panel-head"><h2>Recent purchase orders</h2><button class="btn ghost small" onclick="switchView('pos')">View all</button></div>
      <div class="panel-body">${recentPo.map(d=>recentRow(d.poNo,d.vendor.name,money(d.currency,docTotal(d.items)),statusPill(effectiveStatus(d),daysUntil(dueFieldOf(d))),"po",d.id)).join("") || '<div class="empty">No purchase orders yet.</div>'}</div></div>
  </div>`;
}

/* ---- dashboard charts (Chart.js, with a built-in SVG fallback when the CDN can't load / offline) ---- */
let _dashCharts = {};
function niceCeil(v){ const p=Math.pow(10,Math.floor(Math.log10(v))); const n=v/p; return (n<=1?1:n<=2?2:n<=5?5:10)*p; }
function compactNum(v){ if(v>=1e6) return (v/1e6).toFixed(1).replace(/\.0$/,"")+"M"; if(v>=1e3) return (v/1e3).toFixed(1).replace(/\.0$/,"")+"k"; return String(Math.round(v)); }
function svgBarChart(labels, datasets){
  const W=560,H=210,L=46,R=8,T=10,B=28;
  const max = Math.max(0,...datasets.flatMap(d=>d.data));
  const top = max>0 ? niceCeil(max) : 1;
  const cw = (W-L-R)/labels.length, bw = Math.min(34,(cw*0.7)/datasets.length);
  let g = "";
  for(let i=0;i<=4;i++){
    const y = T+(H-T-B)*(1-i/4);
    g += `<line x1="${L}" x2="${W-R}" y1="${y}" y2="${y}" stroke="#eceef1"/><text x="${L-6}" y="${y+3}" text-anchor="end" font-size="10" fill="#6b6c72">${compactNum(top*i/4)}</text>`;
  }
  labels.forEach((lb,i)=>{
    const cx = L+cw*i+cw/2;
    datasets.forEach((d,j)=>{
      const v = d.data[i]||0, h = (H-T-B)*(v/top);
      const x = cx-(bw*datasets.length)/2+bw*j;
      g += `<rect x="${x.toFixed(1)}" y="${(H-B-h).toFixed(1)}" width="${bw-2}" height="${h.toFixed(1)}" rx="2" fill="${d.color}"><title>${escHtml(d.label)}: ${v.toLocaleString()}</title></rect>`;
    });
    g += `<text x="${cx}" y="${H-10}" text-anchor="middle" font-size="10" fill="#6b6c72">${escHtml(lb)}</text>`;
  });
  const legend = datasets.length>1 ? `<div class="svg-legend">${datasets.map(d=>`<span><i style="background:${d.color}"></i>${escHtml(d.label)}</span>`).join("")}</div>` : "";
  return `<div style="height:${legend?"188":"210"}px"><svg viewBox="0 0 ${W} ${H}" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">${g}</svg></div>${legend}`;
}
function renderDashboardCharts(){
  const cSales = document.getElementById("chartSales"), cExp = document.getElementById("chartExpenses"), cCash = document.getElementById("chartCash");
  if(!cSales || !cExp || !cCash) return;
  Object.values(_dashCharts).forEach(c=>c && c.destroy && c.destroy()); _dashCharts = {};

  const months = [];
  const now = new Date();
  for(let i=5;i>=0;i--){
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    months.push({ key: d.getFullYear()+"-"+pad2(d.getMonth()+1), label: d.toLocaleDateString("en-GB",{month:"short",year:"2-digit"}) });
  }
  const inMonth = (list, key, m) => list.filter(d=>d[key] && d[key].startsWith(m.key)).reduce((s,d)=>s+docTotal(d.items),0);
  const labels = months.map(m=>m.label);
  const salesByMonth = months.map(m=>inMonth(invoices,"invoiceDate",m));
  const inPaid  = months.map(m=>inMonth(invoices.filter(d=>d.status==="paid"),"paidDate",m));
  const outPaid = months.map(m=>inMonth(purchaseOrders.filter(d=>d.status==="paid"),"paidDate",m));

  // expenses by vendor in the selected period
  const range = periodRange(dashPeriod);
  const byVendor = {};
  purchaseOrders.filter(d=>d.poDate>=range.from && d.poDate<=range.to).forEach(d=>{ byVendor[d.vendor.name]=(byVendor[d.vendor.name]||0)+docTotal(d.items); });
  let entries = Object.entries(byVendor).sort((a,b)=>b[1]-a[1]);
  if(entries.length>5){ const rest = entries.slice(5).reduce((s,e)=>s+e[1],0); entries = entries.slice(0,5).concat([["Other",rest]]); }
  const palette = ["#2CA01C","#0077C5","#ff8000","#8d6e63","#6b6c72","#babec5"];

  if(typeof Chart === "undefined"){          // offline / CDN blocked — draw simple SVG charts instead
    cSales.parentNode.innerHTML = svgBarChart(labels,[{label:"Invoiced (£)",data:salesByMonth,color:"#2CA01C"}]);
    cCash.parentNode.innerHTML  = svgBarChart(labels,[{label:"Money in (£)",data:inPaid,color:"#2CA01C"},{label:"Money out ($)",data:outPaid,color:"#0077C5"}]);
    if(entries.length){
      const mx = entries[0][1] || 1;
      cExp.parentNode.innerHTML = entries.map(([n,v],i)=>`<div class="bar-row"><div class="nm" title="${escHtml(n)}">${escHtml(n)}</div><div class="track"><span style="width:${(v/mx*100).toFixed(1)}%;background:${palette[i%palette.length]}"></span></div><div class="amt">${fmtMoneyShort("$",v)}</div></div>`).join("");
    } else cExp.parentNode.innerHTML = '<div class="empty" style="padding:70px 0;">No purchase orders in this period.</div>';
    return;
  }

  const baseOpts = { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:"bottom", labels:{ boxWidth:10, font:{size:11} } } } };
  const axes = { y:{ beginAtZero:true, grid:{color:"#eceef1"}, ticks:{ font:{size:10} } }, x:{ grid:{display:false}, ticks:{ font:{size:10} } } };

  _dashCharts.sales = new Chart(cSales, { type:"bar",
    data:{ labels, datasets:[{ label:"Invoiced (£)", data:salesByMonth, backgroundColor:"#2CA01C", borderRadius:3, maxBarThickness:38 }] },
    options:{ ...baseOpts, plugins:{ legend:{ display:false } }, scales:axes } });

  _dashCharts.cash = new Chart(cCash, { type:"bar",
    data:{ labels, datasets:[
      { label:"Money in (£)", data:inPaid, backgroundColor:"#2CA01C", borderRadius:3, maxBarThickness:26 },
      { label:"Money out ($)", data:outPaid, backgroundColor:"#0077C5", borderRadius:3, maxBarThickness:26 } ] },
    options:{ ...baseOpts, scales:axes } });

  if(entries.length){
    _dashCharts.exp = new Chart(cExp, { type:"doughnut",
      data:{ labels:entries.map(e=>e[0]), datasets:[{ data:entries.map(e=>e[1]), backgroundColor:palette, borderWidth:0 }] },
      options:{ ...baseOpts, cutout:"62%" } });
  } else {
    cExp.parentNode.innerHTML = '<div class="empty" style="padding:70px 0;">No purchase orders in this period.</div>';
  }
}

/* ================= INVOICE LIST ================= */
/* ================= INVOICE LIST ================= */
const LIST_PAGE_SIZE = 50; // keeps the table fast to render even with 10,000+ records
let invoiceListState = { page:1, search:"" };
let poListState = { page:1, search:"" };
function setInvoiceSearch(v){ invoiceListState.search = v; invoiceListState.page = 1; render(); }
function setInvoicePage(p){ invoiceListState.page = p; render(); }
function setPOSearch(v){ poListState.search = v; poListState.page = 1; render(); }
function setPOPage(p){ poListState.page = p; render(); }
function paginationBar(state, setPageFnName, totalCount, filteredCount, totalPages, label){
  if(totalCount===0) return "";
  const from = filteredCount===0 ? 0 : (state.page-1)*LIST_PAGE_SIZE+1;
  const to = Math.min(state.page*LIST_PAGE_SIZE, filteredCount);
  return `<div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 14px;border-top:1px solid #eee;font-size:12px;color:var(--muted);">
    <div>${filteredCount===0 ? `No ${label} match your search.` : `Showing ${from}&ndash;${to} of ${filteredCount} ${label}${filteredCount!==totalCount?` (filtered from ${totalCount})`:""}`}</div>
    <div style="display:flex;gap:6px;align-items:center;">
      <button class="icon-btn" ${state.page<=1?"disabled":""} onclick="${setPageFnName}(${state.page-1})">&laquo; Prev</button>
      <span>Page ${state.page} / ${totalPages}</span>
      <button class="icon-btn" ${state.page>=totalPages?"disabled":""} onclick="${setPageFnName}(${state.page+1})">Next &raquo;</button>
    </div>
  </div>`;
}
function renderInvoiceList(){
  if(invoices.length===0) return '<div class="panel"><div class="empty">No invoices yet. Create your first one.</div></div>';
  const q = invoiceListState.search.trim().toLowerCase();
  const filtered = [...invoices]
    .filter(d=> !q || d.invoiceNo.toLowerCase().includes(q) || d.billTo.company.toLowerCase().includes(q))
    .sort((a,b)=>b.invoiceDate.localeCompare(a.invoiceDate));
  const totalPages = Math.max(1, Math.ceil(filtered.length/LIST_PAGE_SIZE));
  if(invoiceListState.page > totalPages) invoiceListState.page = totalPages;
  if(invoiceListState.page < 1) invoiceListState.page = 1;
  const pageItems = filtered.slice((invoiceListState.page-1)*LIST_PAGE_SIZE, invoiceListState.page*LIST_PAGE_SIZE);
  const rows = pageItems.map(d=>{
    const du = daysUntil(d.dueDate); const st = effectiveStatus(d);
    return `<tr>
      <td class="mono">${escHtml(d.invoiceNo)}</td>
      <td>${escHtml(d.billTo.company)}</td>
      <td class="mono">${fmtDate(d.invoiceDate)}</td>
      <td class="mono">${fmtDate(d.dueDate)}</td>
      <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
      <td>${statusPill(st,du)}</td>
      <td class="right">
        <button class="icon-btn" onclick="previewDoc('invoice','${d.id}')">View / PDF</button>
        ${st!=="paid" ? `<button class="icon-btn" onclick="markPaid('invoice','${d.id}')">Mark paid</button>`:""}
        <button class="icon-btn" onclick="editDoc('invoice','${d.id}')">Edit</button>
        <button class="icon-btn" onclick="deleteDoc('invoice','${d.id}')" style="color:var(--red)">Delete</button>
      </td>
    </tr>`;
  }).join("") || `<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:22px 0;">No invoices match your search.</td></tr>`;
  return `<div class="panel">
    <div class="panel-body pad" style="padding-bottom:0;">
      <div class="field" style="max-width:340px;"><label>Search invoice no. / bill-to</label>
        <input value="${invoiceListState.search.replace(/"/g,'&quot;')}" placeholder="e.g. UKME/INV/2026 or company name" oninput="setInvoiceSearch(this.value)">
      </div>
    </div>
    <div class="panel-body"><table class="grid">
    <thead><tr><th>Invoice No.</th><th>Bill To</th><th>Date</th><th>Due</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead>
    <tbody>${rows}</tbody></table></div>
    ${paginationBar(invoiceListState, "setInvoicePage", invoices.length, filtered.length, totalPages, "invoices")}
  </div>`;
}

/* ================= PO LIST ================= */
function renderPOList(){
  if(purchaseOrders.length===0) return '<div class="panel"><div class="empty">No purchase orders yet. Create your first one.</div></div>';
  const q = poListState.search.trim().toLowerCase();
  const filtered = [...purchaseOrders]
    .filter(d=> !q || d.poNo.toLowerCase().includes(q) || d.vendor.name.toLowerCase().includes(q))
    .sort((a,b)=>b.poDate.localeCompare(a.poDate));
  const totalPages = Math.max(1, Math.ceil(filtered.length/LIST_PAGE_SIZE));
  if(poListState.page > totalPages) poListState.page = totalPages;
  if(poListState.page < 1) poListState.page = 1;
  const pageItems = filtered.slice((poListState.page-1)*LIST_PAGE_SIZE, poListState.page*LIST_PAGE_SIZE);
  const rows = pageItems.map(d=>{
    const du = daysUntil(dueFieldOf(d)); const st = effectiveStatus(d);
    return `<tr>
      <td class="mono">${escHtml(d.poNo)}</td>
      <td>${escHtml(d.vendor.name)}</td>
      <td class="mono">${fmtDate(d.poDate)}</td>
      <td class="mono">${fmtDate(dueFieldOf(d))}</td>
      <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
      <td>${statusPill(st,du)}</td>
      <td class="right">
        <button class="icon-btn" onclick="previewDoc('po','${d.id}')">View / PDF</button>
        ${st!=="paid" ? `<button class="icon-btn" onclick="markPaid('po','${d.id}')">Mark paid</button>`:""}
        <button class="icon-btn" onclick="editDoc('po','${d.id}')">Edit</button>
        <button class="icon-btn" onclick="deleteDoc('po','${d.id}')" style="color:var(--red)">Delete</button>
      </td>
    </tr>`;
  }).join("") || `<tr><td colspan="7" style="text-align:center;color:var(--muted);padding:22px 0;">No purchase orders match your search.</td></tr>`;
  return `<div class="panel">
    <div class="panel-body pad" style="padding-bottom:0;">
      <div class="field" style="max-width:340px;"><label>Search PO no. / vendor</label>
        <input value="${poListState.search.replace(/"/g,'&quot;')}" placeholder="e.g. PO-2026 or vendor name" oninput="setPOSearch(this.value)">
      </div>
    </div>
    <div class="panel-body"><table class="grid">
    <thead><tr><th>PO No.</th><th>Vendor</th><th>Date</th><th>Due</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead>
    <tbody>${rows}</tbody></table></div>
    ${paginationBar(poListState, "setPOPage", purchaseOrders.length, filtered.length, totalPages, "purchase orders")}
  </div>`;
}

/* ================= PAYMENTS TRACKER ================= */
function renderPayments(){
  const docs = allDocs().sort((a,b)=> parseDate(dueFieldOf(a)) - parseDate(dueFieldOf(b)));
  const rows = docs.map(d=>{
    const du = daysUntil(dueFieldOf(d)); const st = effectiveStatus(d);
    return `<tr>
      <td>${d._type==="invoice"?'Receivable':'Payable'}</td>
      <td class="mono">${escHtml(docNoOf(d))}</td>
      <td>${escHtml(d._type==="invoice"? d.billTo.company : d.vendor.name)}</td>
      <td class="mono">${fmtDate(dueFieldOf(d))}</td>
      <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
      <td>${statusPill(st,du)}</td>
      <td class="mono">${d.paidDate?fmtDate(d.paidDate):"—"}</td>
      <td class="right">${st!=="paid" ? `<button class="icon-btn" onclick="markPaid('${d._type}','${d.id}')">Mark paid</button>`:`<button class="icon-btn" onclick="markUnpaid('${d._type}','${d.id}')">Undo</button>`}</td>
    </tr>`;
  }).join("");
  return `<div class="panel"><div class="panel-head"><h2>All invoices &amp; purchase orders</h2></div><div class="panel-body">
    <table class="grid"><thead><tr><th>Direction</th><th>Doc No.</th><th>Party</th><th>Due</th><th class="right">Amount</th><th>Status</th><th>Paid on</th><th></th></tr></thead>
    <tbody>${rows}</tbody></table></div></div>`;
}

/* ================= VENDORS / CLIENTS ================= */
function renderVendors(){
  const clients = {};
  invoices.forEach(d=>{ clients[d.billTo.company] = {type:"Client", ...d.billTo}; });
  const vendors = {};
  purchaseOrders.forEach(d=>{ vendors[d.vendor.name] = {type:"Vendor", ...d.vendor}; });
  const cards = (obj, kind) => Object.values(obj).map(v=>`
    <div class="card" style="grid-column:span 1;">
      <div class="label">${kind}</div>
      <div style="font-weight:700;color:var(--green-dark);margin-top:6px;font-size:14.5px;">${escHtml(v.company||v.name)}</div>
      <div style="font-size:12px;color:var(--muted);margin-top:6px;line-height:1.6;">${escHtml(v.address)}<br>${escHtml(v.email||"")} ${v.phone?"· "+escHtml(v.phone):""}</div>
    </div>`).join("");
  return `<div class="panel"><div class="panel-head"><h2>Clients (billed on invoices)</h2></div>
    <div class="panel-body pad"><div class="cards" style="grid-template-columns:repeat(2,1fr);">${cards(clients,"Client")}</div></div></div>
    <div class="panel"><div class="panel-head"><h2>Vendors (purchase orders placed with)</h2></div>
    <div class="panel-body pad"><div class="cards" style="grid-template-columns:repeat(2,1fr);">${cards(vendors,"Vendor")}</div></div></div>`;
}

/* ================= AGEING HELPER ================= */
function ageingBucket(du){
  // du = days until due (negative = overdue)
  if(du >= 0) return "current";
  const overdueDays = -du;
  if(overdueDays <= 30) return "d1_30";
  if(overdueDays <= 60) return "d31_60";
  return "d60_plus";
}
function ageingLabel(b){
  return {current:"Current", d1_30:"1–30 days overdue", d31_60:"31–60 days overdue", d60_plus:"60+ days overdue"}[b];
}

/* ================= ACCOUNTS RECEIVABLE ================= */
function renderReceivable(){
  const open = invoices.filter(d=>effectiveStatus(d)!=="paid");
  const buckets = {current:0, d1_30:0, d31_60:0, d60_plus:0};
  open.forEach(d=>{ buckets[ageingBucket(daysUntil(d.dueDate))] += docTotal(d.items); });
  const total = Object.values(buckets).reduce((a,b)=>a+b,0);

  const byCustomer = {};
  open.forEach(d=>{
    const key = d.billTo.company;
    if(!byCustomer[key]) byCustomer[key] = { total:0, items:[] };
    byCustomer[key].total += docTotal(d.items);
    byCustomer[key].items.push(d);
  });

  const custRows = Object.entries(byCustomer).sort((a,b)=>b[1].total-a[1].total).map(([name,info])=>{
    const rows = info.items.sort((a,b)=>a.dueDate.localeCompare(b.dueDate)).map(d=>{
      const du = daysUntil(d.dueDate); const st = effectiveStatus(d);
      return `<tr>
        <td class="mono">${escHtml(d.invoiceNo)}</td>
        <td class="mono">${fmtDate(d.invoiceDate)}</td>
        <td class="mono">${fmtDate(d.dueDate)}</td>
        <td>${ageingLabel(ageingBucket(du))}</td>
        <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
        <td>${statusPill(st,du)}</td>
        <td class="right"><button class="icon-btn" onclick="previewDoc('invoice','${d.id}')">View</button><button class="icon-btn" onclick="editDoc('invoice','${d.id}')">Edit</button><button class="icon-btn" onclick="markPaid('invoice','${d.id}')">Mark paid</button></td>
      </tr>`;
    }).join("");
    return `<div class="panel"><div class="panel-head"><h2>${escHtml(name)}</h2><span class="mono" style="font-weight:700;color:var(--green-dark);">£${info.total.toLocaleString(undefined,{minimumFractionDigits:2})}</span></div>
      <div class="panel-body"><table class="grid"><thead><tr><th>Invoice</th><th>Date</th><th>Due</th><th>Ageing</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
  }).join("");

  return `
  <div class="ageing-grid">
    <div class="ageing-cell"><div class="lab">Current</div><div class="val">£${buckets.current.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
    <div class="ageing-cell warn"><div class="lab">1–30 days overdue</div><div class="val">£${buckets.d1_30.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
    <div class="ageing-cell warn"><div class="lab">31–60 days overdue</div><div class="val">£${buckets.d31_60.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
    <div class="ageing-cell bad"><div class="lab">60+ days overdue</div><div class="val">£${buckets.d60_plus.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
  </div>
  <div class="panel"><div class="panel-head"><h2>Total outstanding receivable</h2><span class="mono" style="font-weight:700;font-size:16px;color:var(--green-dark);">£${total.toLocaleString(undefined,{minimumFractionDigits:2})}</span></div></div>
  ${custRows || '<div class="panel"><div class="empty">No open receivables. Everything is collected.</div></div>'}`;
}

/* ================= ACCOUNTS PAYABLE ================= */
function renderPayable(){
  const open = purchaseOrders.filter(d=>effectiveStatus(d)!=="paid");
  const buckets = {current:0, d1_30:0, d31_60:0, d60_plus:0};
  open.forEach(d=>{ buckets[ageingBucket(daysUntil(dueFieldOf(d)))] += docTotal(d.items); });
  const total = Object.values(buckets).reduce((a,b)=>a+b,0);

  const byVendor = {};
  open.forEach(d=>{
    const key = d.vendor.name;
    if(!byVendor[key]) byVendor[key] = { total:0, items:[] };
    byVendor[key].total += docTotal(d.items);
    byVendor[key].items.push(d);
  });

  const vendRows = Object.entries(byVendor).sort((a,b)=>b[1].total-a[1].total).map(([name,info])=>{
    const rows = info.items.sort((a,b)=>dueFieldOf(a).localeCompare(dueFieldOf(b))).map(d=>{
      const du = daysUntil(dueFieldOf(d)); const st = effectiveStatus(d);
      return `<tr>
        <td class="mono">${escHtml(d.poNo)}</td>
        <td class="mono">${fmtDate(d.poDate)}</td>
        <td class="mono">${fmtDate(dueFieldOf(d))}</td>
        <td>${ageingLabel(ageingBucket(du))}</td>
        <td class="right mono">${money(d.currency, docTotal(d.items))}</td>
        <td>${statusPill(st,du)}</td>
        <td class="right"><button class="icon-btn" onclick="previewDoc('po','${d.id}')">View</button><button class="icon-btn" onclick="editDoc('po','${d.id}')">Edit</button><button class="icon-btn" onclick="markPaid('po','${d.id}')">Mark paid</button></td>
      </tr>`;
    }).join("");
    return `<div class="panel"><div class="panel-head"><h2>${escHtml(name)}</h2><span class="mono" style="font-weight:700;color:var(--green-dark);">$${info.total.toLocaleString(undefined,{minimumFractionDigits:2})}</span></div>
      <div class="panel-body"><table class="grid"><thead><tr><th>PO No.</th><th>Date</th><th>Due</th><th>Ageing</th><th class="right">Amount</th><th>Status</th><th></th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
  }).join("");

  return `
  <div class="ageing-grid">
    <div class="ageing-cell"><div class="lab">Current</div><div class="val">$${buckets.current.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
    <div class="ageing-cell warn"><div class="lab">1–30 days overdue</div><div class="val">$${buckets.d1_30.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
    <div class="ageing-cell warn"><div class="lab">31–60 days overdue</div><div class="val">$${buckets.d31_60.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
    <div class="ageing-cell bad"><div class="lab">60+ days overdue</div><div class="val">$${buckets.d60_plus.toLocaleString(undefined,{minimumFractionDigits:2})}</div></div>
  </div>
  <div class="panel"><div class="panel-head"><h2>Total outstanding payable</h2><span class="mono" style="font-weight:700;font-size:16px;color:var(--green-dark);">$${total.toLocaleString(undefined,{minimumFractionDigits:2})}</span></div></div>
  ${vendRows || '<div class="panel"><div class="empty">No open payables. Everything is settled.</div></div>'}`;
}

/* ================= CHART OF ACCOUNTS ================= */
function buildDerivedAccounts(){
  const arBal = invoices.filter(d=>effectiveStatus(d)!=="paid").reduce((s,d)=>s+docTotal(d.items),0);
  const apBal = purchaseOrders.filter(d=>effectiveStatus(d)!=="paid").reduce((s,d)=>s+docTotal(d.items),0);
  const bankGbp = invoices.filter(d=>d.status==="paid").reduce((s,d)=>s+docTotal(d.items),0);
  const bankUsd = purchaseOrders.filter(d=>d.status==="paid").reduce((s,d)=>s+docTotal(d.items),0);
  const salesRev = invoices.reduce((s,d)=>s+docTotal(d.items),0);
  const purchases = purchaseOrders.reduce((s,d)=>s+docTotal(d.items),0);
  return [
    { code:"1000", name:"Bank — GBP", type:"asset", normal:"debit", currency:"£", balance:bankGbp, auto:true, note:"Sum of paid invoices (cash received)" },
    { code:"1010", name:"Bank — USD", type:"asset", normal:"credit", currency:"$", balance:bankUsd, auto:true, note:"Sum of paid purchase orders (cash paid out)" },
    { code:"1100", name:"Accounts Receivable", type:"asset", normal:"debit", currency:"£", balance:arBal, auto:true, note:"Open (unpaid/overdue) invoices" },
    { code:"2100", name:"Accounts Payable", type:"liability", normal:"credit", currency:"$", balance:apBal, auto:true, note:"Open (unpaid/overdue) purchase orders" },
    { code:"4000", name:"Sales Revenue", type:"income", normal:"credit", currency:"£", balance:salesRev, auto:true, note:"All invoices issued (paid + unpaid)" },
    { code:"5000", name:"Purchases / Cost of Goods", type:"expense", normal:"debit", currency:"$", balance:purchases, auto:true, note:"All purchase orders raised (paid + unpaid)" }
  ];
}
function renderChartOfAccounts(){
  const derived = buildDerivedAccounts();
  const rowsFor = (list, editable) => list.map(a=>`<tr>
    <td class="mono">${escHtml(a.code)}</td>
    <td>${escHtml(a.name)}${a.auto?' <span style="font-size:10px;color:var(--muted);">(auto)</span>':''}</td>
    <td><span class="acct-type ${a.type}">${a.type}</span></td>
    <td class="right mono">${a.currency||""}${Number(a.balance).toLocaleString(undefined,{minimumFractionDigits:2})}</td>
    <td style="font-size:11.5px;color:var(--muted);">${escHtml(a.note||"")}</td>
    <td class="right">${editable?`<button class="icon-btn" onclick="editAccount('${a.id}')">Edit</button><button class="icon-btn" style="color:var(--red)" onclick="deleteAccount('${a.id}')">Delete</button>`:""}</td>
  </tr>`).join("");
  return `
  <div class="panel">
    <div class="panel-head"><h2>Automatic accounts — derived live from your invoices &amp; purchase orders</h2></div>
    <div class="panel-body"><table class="grid"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th class="right">Balance</th><th>Source</th><th></th></tr></thead>
    <tbody>${rowsFor(derived,false)}</tbody></table></div>
    <div class="tb-note">These six accounts update automatically as you create, pay, or delete invoices and purchase orders — you don't edit them directly here.</div>
  </div>
  <div class="panel">
    <div class="panel-head"><h2>Your accounts — manual balances (freight, equity, VAT, etc.)</h2></div>
    <div class="panel-body">${manualAccounts.length ? `<table class="grid"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th class="right">Balance</th><th>Source</th><th></th></tr></thead>
    <tbody>${rowsFor(manualAccounts,true)}</tbody></table>` : '<div class="empty">No manual accounts yet — add one for anything this app does not track automatically, like freight or rent.</div>'}</div>
  </div>`;
}
function openAccountForm(editId){
  const editing = editId ? manualAccounts.find(a=>a.id===editId) : null;
  const modal = document.getElementById("formModal");
  modal.innerHTML = `
    <div class="modal-head"><h3>${editing?"Edit Account":"New Account"}</h3><button class="modal-close" onclick="closeForm()">&times;</button></div>
    <div class="modal-body">
      <div class="form-row three">
        <div class="field"><label>Code</label><input id="a_code" value="${editing?escHtml(editing.code):''}" placeholder="5300"></div>
        <div class="field"><label>Type</label><select id="a_type">
          <option value="asset" ${editing&&editing.type==='asset'?'selected':''}>Asset</option>
          <option value="liability" ${editing&&editing.type==='liability'?'selected':''}>Liability</option>
          <option value="equity" ${editing&&editing.type==='equity'?'selected':''}>Equity</option>
          <option value="income" ${editing&&editing.type==='income'?'selected':''}>Income</option>
          <option value="expense" ${editing&&editing.type==='expense'?'selected':''}>Expense</option>
        </select></div>
        <div class="field"><label>Normal balance</label><select id="a_normal">
          <option value="debit" ${editing&&editing.normal==='debit'?'selected':''}>Debit</option>
          <option value="credit" ${editing&&editing.normal==='credit'?'selected':''}>Credit</option>
        </select></div>
      </div>
      <div class="form-row one"><div class="field"><label>Account name</label><input id="a_name" value="${editing?escHtml(editing.name):''}" placeholder="Freight & Logistics"></div></div>
      <div class="form-row"><div class="field"><label>Opening / current balance</label><input id="a_balance" type="number" step="0.01" value="${editing?editing.balance:0}"></div></div>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" onclick="closeForm()">Cancel</button>
      <button class="btn" onclick="saveAccount(${editing?`'${editing.id}'`:'null'})">Save account</button>
    </div>`;
  document.getElementById("formOverlay").classList.add("show");
}
function editAccount(id){ openAccountForm(id); }
function saveAccount(id){
  const code = document.getElementById("a_code").value.trim();
  const name = document.getElementById("a_name").value.trim();
  const type = document.getElementById("a_type").value;
  const normal = document.getElementById("a_normal").value;
  const balance = parseFloat(document.getElementById("a_balance").value)||0;
  if(!code || !name){ alert("Please enter both a code and an account name."); return; }
  if(id){
    const a = manualAccounts.find(x=>x.id===id);
    Object.assign(a, {code,name,type,normal,balance});
  }else{
    manualAccounts.push({ id:uid("acc"), code, name, type, normal, balance });
  }
  saveMeta();
  closeForm(); switchView("coa");
}
function deleteAccount(id){
  if(!confirm("Delete this account?")) return;
  manualAccounts = manualAccounts.filter(a=>a.id!==id);
  saveMeta();
  render();
}

/* ================= TRIAL BALANCE ================= */
function renderTrialBalance(){
  const derived = buildDerivedAccounts();
  const rowOf = a => {
    const isDebitNormal = a.normal==="debit";
    return `<tr>
      <td class="mono">${escHtml(a.code)}</td>
      <td>${escHtml(a.name)}</td>
      <td><span class="acct-type ${a.type}">${a.type}</span></td>
      <td class="right mono">${isDebitNormal ? (a.currency||"")+Number(a.balance).toLocaleString(undefined,{minimumFractionDigits:2}) : ""}</td>
      <td class="right mono">${!isDebitNormal ? (a.currency||"")+Number(a.balance).toLocaleString(undefined,{minimumFractionDigits:2}) : ""}</td>
    </tr>`;
  };
  const gbpAccts = derived.filter(a=>a.currency==="£");
  const usdAccts = derived.filter(a=>a.currency==="$");
  const gbpDr = gbpAccts.filter(a=>a.normal==="debit").reduce((s,a)=>s+a.balance,0);
  const gbpCr = gbpAccts.filter(a=>a.normal==="credit").reduce((s,a)=>s+a.balance,0);
  const usdDr = usdAccts.filter(a=>a.normal==="debit").reduce((s,a)=>s+a.balance,0);
  const usdCr = usdAccts.filter(a=>a.normal==="credit").reduce((s,a)=>s+a.balance,0);

  const manRows = manualAccounts.map(rowOf).join("");
  const manDr = manualAccounts.filter(a=>a.normal==="debit").reduce((s,a)=>s+Number(a.balance),0);
  const manCr = manualAccounts.filter(a=>a.normal==="credit").reduce((s,a)=>s+Number(a.balance),0);

  return `
  <div class="panel">
    <div class="panel-head"><h2>Sales ledger — GBP (invoices)</h2></div>
    <div class="panel-body"><table class="grid"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th class="right">Debit</th><th class="right">Credit</th></tr></thead>
    <tbody>${gbpAccts.map(rowOf).join("")}</tbody>
    <tfoot><tr><td colspan="3" class="right" style="font-weight:700;">Total</td><td class="right mono" style="font-weight:700;">£${gbpDr.toLocaleString(undefined,{minimumFractionDigits:2})}</td><td class="right mono" style="font-weight:700;">£${gbpCr.toLocaleString(undefined,{minimumFractionDigits:2})}</td></tr></tfoot>
    </table></div>
    <div class="tb-note">${Math.abs(gbpDr-gbpCr)<0.005 ? "✓ Balanced — Accounts Receivable + Bank (GBP) equal Sales Revenue." : "⚠ Out of balance — this shouldn't happen; check for data corruption."}</div>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Purchase ledger — USD (purchase orders)</h2></div>
    <div class="panel-body"><table class="grid"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th class="right">Debit</th><th class="right">Credit</th></tr></thead>
    <tbody>${usdAccts.map(rowOf).join("")}</tbody>
    <tfoot><tr><td colspan="3" class="right" style="font-weight:700;">Total</td><td class="right mono" style="font-weight:700;">$${usdDr.toLocaleString(undefined,{minimumFractionDigits:2})}</td><td class="right mono" style="font-weight:700;">$${usdCr.toLocaleString(undefined,{minimumFractionDigits:2})}</td></tr></tfoot>
    </table></div>
    <div class="tb-note">${Math.abs(usdDr-usdCr)<0.005 ? "✓ Balanced — Purchases equal Accounts Payable + Bank (USD)." : "⚠ Out of balance — this shouldn't happen; check for data corruption."}</div>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Manual accounts (reference only)</h2></div>
    <div class="panel-body">${manualAccounts.length ? `<table class="grid"><thead><tr><th>Code</th><th>Account</th><th>Type</th><th class="right">Debit</th><th class="right">Credit</th></tr></thead>
    <tbody>${manRows}</tbody>
    <tfoot><tr><td colspan="3" class="right" style="font-weight:700;">Total</td><td class="right mono" style="font-weight:700;">${manDr.toLocaleString(undefined,{minimumFractionDigits:2})}</td><td class="right mono" style="font-weight:700;">${manCr.toLocaleString(undefined,{minimumFractionDigits:2})}</td></tr></tfoot>
    </table>` : '<div class="empty">No manual accounts added yet.</div>'}</div>
    <div class="tb-note">These are balances you enter yourself in Chart of Accounts — they're kept separate here because nothing in the app posts an offsetting entry for them automatically, so they aren't guaranteed to balance against each other.</div>
  </div>`;
}

/* ================= SETTINGS ================= */
function settingsImagesHtml(){
  const auth = getAuth();
  return `
  <div class="panel">
    <div class="panel-head"><h2>Document images — signatures &amp; company stamp</h2></div>
    <div class="panel-body">
      <div class="settings-row">
        <div class="prev"><img src="${currentPreparedSignatureImg()}" alt="prepared-by signature"></div>
        <div class="info"><b>"Prepared By" signature</b><span>${customPreparedSignature ? "Your uploaded signature" : "Sample placeholder — shown in the Prepared By box until you upload your own"}</span></div>
        <div class="settings-actions">
          <label class="btn ghost small file-btn">Upload<input type="file" accept="image/*" onchange="uploadImage(event,'preparedSignature')"></label>
          ${customPreparedSignature ? '<button class="btn danger small" onclick="clearImage(\'preparedSignature\')">Remove</button>' : ""}
        </div>
      </div>
      <div class="settings-row">
        <div class="prev"><img src="${currentSignatureImg()}" alt="signature"></div>
        <div class="info"><b>Authorised / Approved signature</b><span>${customSignature ? "Your uploaded signature" : "Sample placeholder — shown in the Authorised Signature / Approved By Director box until you upload your own"}</span></div>
        <div class="settings-actions">
          <label class="btn ghost small file-btn">Upload<input type="file" accept="image/*" onchange="uploadImage(event,'signature')"></label>
          ${customSignature ? '<button class="btn danger small" onclick="clearImage(\'signature\')">Remove</button>' : ""}
        </div>
      </div>
      <div class="settings-row">
        <div class="prev"><img src="${currentStampImg()}" alt="stamp"></div>
        <div class="info"><b>Company stamp</b><span>${customStamp ? "Your uploaded stamp" : "UKME's official company stamp — used on every invoice &amp; PO"}</span></div>
        <div class="settings-actions">
          <label class="btn ghost small file-btn">Upload<input type="file" accept="image/*" onchange="uploadImage(event,'stamp')"></label>
          ${customStamp ? '<button class="btn danger small" onclick="clearImage(\'stamp\')">Remove</button>' : ""}
        </div>
      </div>
    </div>
    <div class="tb-note">Upload clear photos or scans (PNG with a transparent background works best). "Prepared By" and "Authorised / Approved" are two different, independently replaceable signatures — since they're normally two different people. They replace the sample images on every invoice and PO PDF immediately, for everyone using this browser.</div>
  </div>`;
}
function settingsSignInHtml(){
  const auth = getAuth();
  return `
  <div class="panel">
    <div class="panel-head"><h2>Sign-in</h2></div>
    <div class="panel-body pad">
      <div class="form-row three">
        <div class="field"><label>Username</label><input id="s_user" value="${escHtml(auth.username)}"></div>
        <div class="field"><label>Current password</label><input id="s_curpass" type="password" placeholder="required to change anything"></div>
        <div class="field"><label>New password</label><input id="s_newpass" type="password" placeholder="leave blank to keep current"></div>
      </div>
      <button class="btn" onclick="changeCredentials()">Save sign-in details</button>
      <div id="credsMsg" style="margin-top:10px;font-size:12.5px;"></div>
      <div class="tb-note" style="margin-top:16px;padding:12px 0 0 0;border-top:none;">Passwords are hashed (SHA-256) and repeated failed sign-ins are locked out for a bit, and the app signs you out automatically after 20 minutes idle. Even so, this is a screen lock, not a vault: there's no server, so anyone who opens the file itself, or your browser's dev tools, can bypass the login or read the data. Don't rely on this alone for sensitive financial data — see below.</div>
    </div>
  </div>`;
}
function settingsSecurityHtml(){
  const auth = getAuth();
  return `
  <div class="panel">
    <div class="panel-head"><h2>About security on this app</h2></div>
    <div class="panel-body pad">
      <p style="font-size:12.5px;color:var(--muted);margin:0 0 8px 0;line-height:1.7;">This is a single HTML file with no server behind it — everything (invoices, purchase orders, bank details, the sign-in check) runs and is stored in this one browser, in plain form. That gives it a hard ceiling: no file running entirely in someone's browser can be made unhackable, because the person holding the file also holds every key to it.</p>
      <p style="font-size:12.5px;color:var(--muted);margin:0 0 8px 0;line-height:1.7;">What this update adds is real, but modest: a proper SHA-256 password hash instead of a toy one, a login lockout after repeated failed attempts, and an automatic sign-out when idle. What it can't do: stop someone who has the file (or your browser's dev tools) from reading the data directly, editing the page to skip the login, or copying the file elsewhere.</p>
      <p style="font-size:12.5px;color:var(--muted);margin:0;line-height:1.7;">If this needs to hold real client/vendor financial data and be safe from a determined person — not just a casual glance — the fix is a real backend: a server that holds the data and checks logins, with the browser only ever seeing what that person is allowed to see. That's a different kind of project from this file; happy to help plan it if useful.</p>
    </div>
  </div>`;
}
function settingsDataHtml(){
  const auth = getAuth();
  return `
  <div class="panel">
    <div class="panel-head"><h2>App data</h2></div>
    <div class="panel-body pad">
      <p style="font-size:12.5px;color:var(--muted);margin:0 0 12px 0;">Everything you enter is saved in this browser only — there is no server and no cloud copy. If this file is opened from a different location, in a private/incognito tab, or inside an embedded preview (e.g. VS Code's built-in browser tab) that doesn't keep browser storage between sessions, it will look like your data — or even your deletions — "came back": really the browser just started empty again and loaded the file's built-in sample data. Always open this from the same fixed local-server address in a real browser tab (not an editor's preview pane), and export a backup regularly.</p>
      <div class="settings-actions" style="margin-bottom:14px;">
        <button class="btn ghost small" onclick="exportDataBackup()">Download backup (.json)</button>
        <label class="btn ghost small file-btn">Restore from backup<input type="file" accept="application/json" onchange="importDataBackup(event)"></label>
      </div>
      <button class="btn danger" onclick="resetToSampleData()">Reset all data to sample data</button>
      <div class="tb-note" style="margin-top:14px;padding:10px 0 0 0;border-top:none;">Reset and Restore now both require typing a confirmation word — nothing gets wiped or replaced by an accidental click.</div>
    </div>
  </div>`;
}

/* ================= SETTINGS (QuickBooks-style "Account and settings") ================= */
let settingsTab = "company";
let settingsEdit = null;   // id of the section currently being edited (pencil clicked)
const MONTH_NAMES = ["January","February","March","April","May","June","July","August","September","October","November","December"];

function coSet(key){ return { get:()=>COMPANY[key]||"", set:v=>{ settings.company[key]=v; } }; }
function bankSet(key){ return { get:()=>(COMPANY.bank||{})[key]||"", set:v=>{ settings.company.bank = Object.assign({}, COMPANY.bank, settings.company.bank||{}, {[key]:v}); } }; }

const SETTINGS_SECTIONS = {
  company:[
    { id:"co_info", title:"Company name & details", desc:"Shown in the header of every invoice, purchase order and report.",
      fields:[ Object.assign({key:"name",label:"Company name"},coSet("name")), Object.assign({key:"regNo",label:"Company Reg. No."},coSet("regNo")), Object.assign({key:"vat",label:"Company VAT No."},coSet("vat")) ] },
    { id:"co_contact", title:"Contact info", desc:"Shown in the footer of every document.",
      fields:[ Object.assign({key:"phone",label:"Phone"},coSet("phone")), Object.assign({key:"email",label:"Email"},coSet("email")), Object.assign({key:"website",label:"Website"},coSet("website")) ] },
    { id:"co_address", title:"Company address", desc:"One line per row — printed under the company reg. no. in the document header.",
      fields:[ { key:"address", label:"Address", type:"textarea", get:()=>COMPANY.addressLines.join("\n"), set:v=>{ settings.company.address=v; } } ] },
    { id:"co_bank", title:"Bank details", desc:"Printed in the Bank Details box on every invoice.",
      fields:[ Object.assign({key:"bankName",label:"Bank name"},bankSet("bankName")), Object.assign({key:"sortCode",label:"Sort code"},bankSet("sortCode")), Object.assign({key:"account",label:"Account no."},bankSet("account")), Object.assign({key:"iban",label:"IBAN"},bankSet("iban")), Object.assign({key:"swift",label:"SWIFT / BIC"},bankSet("swift")) ] }
  ],
  sales:[
    { id:"sa_numbering", title:"Invoice numbering", desc:"How new invoice numbers are built. The next number is used the next time you create an invoice.",
      fields:[
        { key:"invPrefix", label:"Invoice prefix", get:()=>settings.sales.invPrefix, set:v=>{ settings.sales.invPrefix=v; } },
        { key:"invPad", label:"Number length (digits)", type:"number", min:1, max:8, get:()=>settings.sales.invPad, set:v=>{ settings.sales.invPad=Math.min(8,Math.max(1,parseInt(v)||3)); } },
        { key:"nextInv", label:"Next invoice number", type:"number", min:1, get:()=>seq.inv, set:v=>{ seq.inv=Math.max(1,parseInt(v)||1); } }
      ], preview:()=>"Next invoice: "+nextInvoiceNumber() },
    { id:"sa_terms", title:"Payment terms & shipping defaults", desc:"Pre-filled on each new invoice — you can still change them per invoice.",
      fields:[
        { key:"dueDays", label:"Default debtor days (customers pay within)", type:"number", min:0, get:()=>settings.sales.dueDays, set:v=>{ settings.sales.dueDays=Math.max(0,parseInt(v)||0); } },
        { key:"incoterms", label:"Default incoterms", get:()=>settings.sales.incoterms, set:v=>{ settings.sales.incoterms=v; } }
      ] },
    { id:"sa_message", title:"Default message on invoices", desc:"Pre-filled in the Message / notes box. Printed on the invoice only when it isn't empty.",
      fields:[ { key:"message", label:"Message", type:"textarea", get:()=>settings.sales.message, set:v=>{ settings.sales.message=v; } } ] }
  ],
  expenses:[
    { id:"ex_numbering", title:"Purchase order numbering", desc:"How new PO numbers are built.",
      fields:[
        { key:"poPrefix", label:"PO prefix", get:()=>settings.expenses.poPrefix, set:v=>{ settings.expenses.poPrefix=v; } },
        { key:"poPad", label:"Number length (digits)", type:"number", min:1, max:8, get:()=>settings.expenses.poPad, set:v=>{ settings.expenses.poPad=Math.min(8,Math.max(1,parseInt(v)||3)); } },
        { key:"nextPo", label:"Next PO number", type:"number", min:1, get:()=>seq.po, set:v=>{ seq.po=Math.max(1,parseInt(v)||1); } }
      ], preview:()=>"Next PO: "+nextPONumber() },
    { id:"ex_defaults", title:"Delivery defaults", desc:"Pre-filled on each new purchase order.",
      fields:[
        { key:"destination", label:"Default delivery destination", get:()=>settings.expenses.destination, set:v=>{ settings.expenses.destination=v; } },
        { key:"creditDays", label:"Default creditor days (we pay vendors within)", type:"number", min:0, get:()=>settings.expenses.creditDays, set:v=>{ settings.expenses.creditDays=Math.max(0,parseInt(v)||0); } },
        { key:"deliveryDays", label:"Default delivery after (days)", type:"number", min:0, get:()=>settings.expenses.deliveryDays, set:v=>{ settings.expenses.deliveryDays=Math.max(0,parseInt(v)||0); } }
      ] },
    { id:"ex_message", title:"Default message on purchase orders", desc:"Pre-filled in the Message / notes box. Printed on the PO only when it isn't empty.",
      fields:[ { key:"message", label:"Message", type:"textarea", get:()=>settings.expenses.message, set:v=>{ settings.expenses.message=v; } } ] }
  ],
  payments:[
    { id:"pay_reminders", title:"Payment reminders", desc:"Documents due within this many days (and all overdue ones) appear under Payment reminders on the dashboard and turn amber in lists.",
      fields:[ { key:"reminderDays", label:"Remind me (days before due)", type:"number", min:0, max:60, get:()=>settings.payments.reminderDays, set:v=>{ settings.payments.reminderDays=Math.min(60,Math.max(0,parseInt(v)||0)); } } ] }
  ],
  advanced:[
    { id:"adv_accounting", title:"Accounting", desc:"Decides what \"This fiscal year\" means on the dashboard.",
      fields:[ { key:"fiscalStartMonth", label:"First month of fiscal year", type:"select", options:MONTH_NAMES.map((m,i)=>[String(i+1),m]), get:()=>String(settings.advanced.fiscalStartMonth), set:v=>{ settings.advanced.fiscalStartMonth=Math.min(12,Math.max(1,parseInt(v)||1)); } } ] },
    { id:"adv_security", title:"Automatic sign-out", desc:"You're signed out after this many idle minutes.",
      fields:[ { key:"idleMinutes", label:"Sign out after (minutes idle)", type:"number", min:1, max:240, get:()=>settings.advanced.idleMinutes, set:v=>{ settings.advanced.idleMinutes=Math.min(240,Math.max(1,parseInt(v)||20)); } } ] }
  ]
};
const SETTINGS_TABS = [["company","Company"],["sales","Sales"],["expenses","Expenses"],["payments","Payments"],["advanced","Advanced"]];
const PENCIL_SVG = '<svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>';

function setSettingsTab(t){ settingsTab = t; settingsEdit = null; render(); }
function editSettingsSection(id){ settingsEdit = id; render(); }
function cancelSettingsEdit(){ settingsEdit = null; render(); }
function fieldDisplay(f){
  const v = f.get();
  if(f.type==="select"){ const o=(f.options||[]).find(x=>x[0]===String(v)); return o?o[1]:v; }
  if(v===undefined || v===null || String(v)==="") return '<span style="color:#9a9ba1">— not set —</span>';
  return escHtml(v).replace(/\n/g,"<br>");
}
function renderSettingsSection(sec){
  const editing = settingsEdit === sec.id;
  let body;
  if(editing){
    body = sec.fields.map(f=>{
      const id = "sf_"+sec.id+"_"+f.key;
      const val = f.get();
      let input;
      if(f.type==="textarea") input = `<textarea id="${id}" rows="3">${escHtml(val)}</textarea>`;
      else if(f.type==="select") input = `<select id="${id}">${(f.options||[]).map(o=>`<option value="${o[0]}" ${o[0]===String(val)?"selected":""}>${o[1]}</option>`).join("")}</select>`;
      else input = `<input id="${id}" type="${f.type||"text"}" ${f.min!==undefined?`min="${f.min}"`:""} ${f.max!==undefined?`max="${f.max}"`:""} value="${escHtml(val)}">`;
      return `<div class="field" style="margin-bottom:12px;"><label>${f.label}</label>${input}</div>`;
    }).join("") + `<div class="qb-form-actions"><button class="btn ghost small" onclick="cancelSettingsEdit()">Cancel</button><button class="btn small" onclick="saveSettingsSection('${sec.id}')">Save</button></div>`;
  } else {
    body = '<div class="qb-kv">' + sec.fields.map(f=>`<div class="k">${f.label}</div><div>${fieldDisplay(f)}</div>`).join("") + '</div>'
         + (sec.preview ? `<div class="qb-note" style="margin-top:10px;">${escHtml(sec.preview())}</div>` : "");
  }
  return `<div class="qb-sec">
    <div><h4>${sec.title}</h4><div class="desc">${sec.desc||""}</div></div>
    <div>${body}</div>
    <div>${editing ? "" : `<button class="qb-pencil" title="Edit" onclick="editSettingsSection('${sec.id}')">${PENCIL_SVG}</button>`}</div>
  </div>`;
}
function saveSettingsSection(id){
  let sec = null;
  for(const k of Object.keys(SETTINGS_SECTIONS)){ const f = SETTINGS_SECTIONS[k].find(s=>s.id===id); if(f) sec=f; }
  if(!sec) return;
  sec.fields.forEach(f=>{ const el = document.getElementById("sf_"+id+"_"+f.key); if(el) f.set(el.value); });
  applySettings();
  saveMeta();
  settingsEdit = null;
  render();
}
function renderSettings(){
  const tabTitle = (SETTINGS_TABS.find(t=>t[0]===settingsTab)||[])[1] || "";
  const secs = (SETTINGS_SECTIONS[settingsTab]||[]).map(renderSettingsSection).join("");
  let extra = "";
  if(settingsTab==="company") extra = settingsImagesHtml();
  if(settingsTab==="advanced") extra = settingsSignInHtml() + settingsDataHtml() + settingsSecurityHtml();
  return `<div class="qb-settings">
    <div class="qb-set-nav">${SETTINGS_TABS.map(t=>`<button class="${t[0]===settingsTab?"active":""}" onclick="setSettingsTab('${t[0]}')">${t[1]}</button>`).join("")}</div>
    <div class="qb-set-col">
      <div class="qb-set-main"><h2>${tabTitle}</h2>${secs}</div>
      ${extra}
    </div>
  </div>`;
}

function uploadImage(evt, kind){
  const file = evt.target.files && evt.target.files[0];
  if(!file) return;
  if(!/^image\/(png|jpe?g|gif|webp)$/i.test(file.type)){ alert("Please choose a PNG, JPG, GIF or WEBP image."); evt.target.value=""; return; }
  if(file.size > 1.5*1024*1024){ alert("This image is "+(file.size/1048576).toFixed(1)+" MB. Please use an image under 1.5 MB (a signature or stamp does not need more) — a very large image makes every save and backup slow."); evt.target.value=""; return; }
  const reader = new FileReader();
  reader.onload = function(){
    if(kind==="signature") customSignature = reader.result;
    else if(kind==="preparedSignature") customPreparedSignature = reader.result;
    else customStamp = reader.result;
    saveMeta();
    switchView("settings");
  };
  reader.readAsDataURL(file);
}
function clearImage(kind){
  if(kind==="signature") customSignature = null;
  else if(kind==="preparedSignature") customPreparedSignature = null;
  else customStamp = null;
  saveMeta();
  switchView("settings");
}
async function changeCredentials(){
  const auth = getAuth();
  const cur = document.getElementById("s_curpass").value;
  const newUser = document.getElementById("s_user").value.trim();
  const newPass = document.getElementById("s_newpass").value;
  const msg = document.getElementById("credsMsg");
  const ok = await verifyAuth(auth.username, cur);
  if(!ok){
    msg.textContent = "Current password is incorrect.";
    msg.style.color = "var(--red)";
    return;
  }
  if(!newUser){
    msg.textContent = "Username can't be empty.";
    msg.style.color = "var(--red)";
    return;
  }
  if(newPass && newPass.length < 6){
    msg.textContent = "New password should be at least 6 characters.";
    msg.style.color = "var(--red)";
    return;
  }
  await setAuth(newUser, newPass ? newPass : cur);
  msg.textContent = "Saved. Use the new details next time you sign in.";
  msg.style.color = "var(--green)";
}

/* ================= ACTIONS ================= */
function markPaid(type,id){
  const list = type==="invoice"?invoices:purchaseOrders;
  const d = list.find(x=>x.id===id);
  if(!d) return;
  const today = toISO(new Date());
  const isInv = type==="invoice";
  const party = isInv ? ((d.billTo||{}).company||"") : ((d.vendor||{}).name||"");
  const docNo = (isInv ? d.invoiceNo : d.poNo) || "";
  const total = money(d.currency||"", docTotal(d.items||[]));
  document.getElementById("formModal").innerHTML = `
    <div class="modal-head"><h3>${isInv?"Payment received":"Payment made"} — ${escHtml(docNo)}</h3><button class="modal-close" onclick="closeForm()">&times;</button></div>
    <div class="modal-body">
      <div style="font-size:13px;color:var(--muted);margin-bottom:12px;">${escHtml(party)} &middot; ${escHtml(total)}</div>
      <div class="field"><label>${isInv?"Date payment was received":"Date payment was made"}</label>
        <input id="pd_date" type="date" value="${today > (isInv?d.invoiceDate:d.poDate) ? today : (isInv?d.invoiceDate:d.poDate)}" min="${escHtml(isInv?d.invoiceDate:d.poDate)}" max="${today}" style="max-width:220px;">
      </div>
      <div style="font-size:12px;color:var(--muted);margin-top:8px;">Choose the day the payment was actually ${isInv?"received":"made"} (defaults to today). The Statement, Cash flow and Payment Tracker all use this date.</div>
      <div id="pd_err" style="color:var(--red);font-size:12.5px;margin-top:8px;"></div>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" onclick="closeForm()">Cancel</button>
      <button class="btn" onclick="confirmMarkPaid('${type}','${id}')">Mark paid</button>
    </div>`;
  document.getElementById("formOverlay").classList.add("show");
  const inp = document.getElementById("pd_date"); if(inp) inp.focus();
}
function confirmMarkPaid(type,id){
  const list = type==="invoice"?invoices:purchaseOrders;
  const d = list.find(x=>x.id===id);
  if(!d) return;
  const val = document.getElementById("pd_date").value;
  const err = document.getElementById("pd_err");
  if(!val){ err.textContent = "Please choose a date."; return; }
  if(val > toISO(new Date())){ err.textContent = "The payment date cannot be in the future."; return; }
  const docDate = type==="invoice" ? d.invoiceDate : d.poDate;
  if(docDate && val < docDate){ err.textContent = "The payment date cannot be before the "+(type==="invoice"?"invoice":"purchase order")+" date ("+fmtDate(docDate)+")."; return; }
  d.status = "paid"; d.paidDate = val;
  (type==="invoice"?saveInvoiceRecord:savePORecord)(d);
  closeForm(); render();
}
function markUnpaid(type,id){
  const list = type==="invoice"?invoices:purchaseOrders;
  const d = list.find(x=>x.id===id);
  if(d){ d.status="unpaid"; d.paidDate=null; (type==="invoice"?saveInvoiceRecord:savePORecord)(d); render(); }
}
function deleteDoc(type,id){
  if(!confirm("Delete this document? This cannot be undone.")) return;
  if(type==="invoice"){ invoices = invoices.filter(x=>x.id!==id); deleteInvoiceRecord(id); }
  else{ purchaseOrders = purchaseOrders.filter(x=>x.id!==id); deletePORecord(id); }
  render();
}

/* ================= CUSTOMER / VENDOR AUTO-FILL ================= */
/* Builds { "Company Name": {company,address,email,trn,license,phone} } from
   the most recent invoice for each customer, so picking a customer name
   re-uses everything already known about them. */
function buildCustomerIndex(){
  const idx = {};
  [...invoices].sort((a,b)=> (a.invoiceDate||"").localeCompare(b.invoiceDate||"")).forEach(d=>{
    if(d.billTo && d.billTo.company) idx[d.billTo.company] = d.billTo;
  });
  return idx;
}
/* Same idea for vendors, built from purchase orders. */
function buildVendorIndex(){
  const idx = {};
  [...purchaseOrders].sort((a,b)=> (a.poDate||"").localeCompare(b.poDate||"")).forEach(d=>{
    if(d.vendor && d.vendor.name) idx[d.vendor.name] = d.vendor;
  });
  return idx;
}
function customerDatalistOptions(){
  return Object.keys(buildCustomerIndex()).map(name=>`<option value="${name.replace(/"/g,"&quot;")}">`).join("");
}
function vendorDatalistOptions(){
  return Object.keys(buildVendorIndex()).map(name=>`<option value="${name.replace(/"/g,"&quot;")}">`).join("");
}
function onCustomerSelect(name){
  const idx = buildCustomerIndex();
  const c = idx[name];
  if(!c) return; // typed a new customer name — leave fields as-is
  document.getElementById("f_billAddress").value = c.address||"";
  document.getElementById("f_billEmail").value = c.email||"";
  document.getElementById("f_billTrn").value = c.trn||"";
  document.getElementById("f_billLicense").value = c.license||"";
  document.getElementById("f_billPhone").value = c.phone||"";
}
function onVendorSelect(name){
  const idx = buildVendorIndex();
  const v = idx[name];
  if(!v) return; // typed a new vendor name — leave fields as-is
  document.getElementById("p_vendorAddress").value = v.address||"";
  document.getElementById("p_vendorPhone").value = v.phone||"";
  document.getElementById("p_vendorEmail").value = v.email||"";
  document.getElementById("p_vendorVat").value = v.vat||"";
}

/* ================= INVOICE FORM ================= */
/* ================= SHARED FORM HELPERS ================= */
function escHtml(v){ return String(v==null?"":v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function addDaysISO(iso, n){ const d=parseDate(iso); d.setDate(d.getDate()+(Number(n)||0)); return toISO(d); }
function nextInvoiceNumber(){ const s=settings.sales; return s.invPrefix + String(seq.inv).padStart(Number(s.invPad)||0,"0"); }
function nextPONumber(){ const s=settings.expenses; return s.poPrefix + String(seq.po).padStart(Number(s.poPad)||0,"0"); }
function editDoc(type,id){
  closePreview();
  if(type==="invoice") openInvoiceForm(id); else openPOForm(id);
}

/* ---- Payment terms (debtor days on invoices / creditor days on POs): pick the days, due date is calculated ---- */
const TERM_CHOICES = [0,7,14,15,21,30,45,60,75,90,120];
function termLabel(n){ return n===0 ? "Due on receipt (0 days)" : n+" days"; }
function daysBetweenISO(a,b){ return Math.round((parseDate(b)-parseDate(a))/86400000); }
function termsFieldsHtml(pre, days, dueDate, kind){
  const isCustom = !TERM_CHOICES.includes(days);
  const lbl = kind==="invoice" ? "Debtor days (customer pays within)" : "Creditor days (we pay within)";
  return `
        <div class="field"><label>${lbl}</label>
          <select id="${pre}_terms" onchange="onTermsChange('${pre}')">
            ${TERM_CHOICES.map(n=>`<option value="${n}" ${!isCustom&&n===days?"selected":""}>${termLabel(n)}</option>`).join("")}
            <option value="custom" ${isCustom?"selected":""}>Custom…</option>
          </select></div>
        <div class="field"><label>Custom days</label><input id="${pre}_termsCustom" type="number" min="0" step="1" value="${isCustom?days:""}" placeholder="e.g. 40" ${isCustom?"":"disabled"} oninput="onTermsChange('${pre}')"></div>
        <div class="field"><label>Payment due date (auto)</label><input id="${pre}_dueDate" type="date" value="${escHtml(dueDate)}" readonly style="background:#f3f1e8;"></div>`;
}
function termsDaysOf(pre){
  const sel = document.getElementById(pre+"_terms").value;
  if(sel!=="custom") return parseInt(sel)||0;
  return Math.max(0, parseInt(document.getElementById(pre+"_termsCustom").value)||0);
}
function onTermsChange(pre){
  const sel = document.getElementById(pre+"_terms").value;
  const cu = document.getElementById(pre+"_termsCustom");
  cu.disabled = sel!=="custom";
  const base = document.getElementById(pre==="f" ? "f_invoiceDate" : "p_poDate").value;
  if(base) document.getElementById(pre+"_dueDate").value = addDaysISO(base, termsDaysOf(pre));
}

/* ================= INVOICE FORM (new + edit) ================= */
/* ---- Currency choices for invoices & purchase orders (default: invoice = £, PO = $) ---- */
const CURRENCY_OPTIONS = [
  ["$","USD — US Dollar ($)"], ["£","GBP — Pound Sterling (£)"], ["€","EUR — Euro (€)"],
  ["AED ","AED — UAE Dirham"], ["SAR ","SAR — Saudi Riyal"], ["PKR ","PKR — Pakistani Rupee"],
  ["CA$","CAD — Canadian Dollar (CA$)"], ["A$","AUD — Australian Dollar (A$)"], ["CHF ","CHF — Swiss Franc"], ["INR ","INR — Indian Rupee"]
];
function currencySelectHtml(id, current, onchangeFn){
  const cur = current || "";
  const opts = CURRENCY_OPTIONS.slice();
  if(cur && !opts.some(o=>o[0]===cur)) opts.push([cur, cur.trim()]);
  return `<select id="${id}" onchange="${onchangeFn}()">${opts.map(o=>`<option value="${escHtml(o[0])}" ${o[0]===cur?"selected":""}>${escHtml(o[1])}</option>`).join("")}</select>`;
}
function formCurrency(id, fallback){ const el = document.getElementById(id); return el ? el.value : fallback; }
function symOf(cur){ return String(cur||"").trim(); }
function onInvCurrencyChange(){ const c = symOf(formCurrency("f_currency","£")); const h = document.getElementById("invUnitHead"); if(h) h.textContent = "Unit "+c; updateInvTotal(); }
function onPoCurrencyChange(){ const c = symOf(formCurrency("p_currency","$")); const h = document.getElementById("poUnitHead"); if(h) h.textContent = "Unit "+c; updatePoTotal(); }

function openInvoiceForm(editId){
  const ed = editId ? invoices.find(x=>x.id===editId) : null;
  if(editId && !ed){ alert("Invoice not found."); return; }
  const today = toISO(new Date());
  const v = ed || {
    invoiceNo: nextInvoiceNumber(), invoiceDate: today, dueDate: addDaysISO(today, settings.sales.dueDays), termsDays: settings.sales.dueDays,
    customerRef:"", orderNo:"", billTo:{}, shipping:{ incoterms: settings.sales.incoterms||"" },
    items:[], note: settings.sales.message||"", status:"unpaid", paidDate:null
  };
  const b = v.billTo||{}, sh = v.shipping||{};
  const invTerms = (v.termsDays!=null) ? Number(v.termsDays) : Math.max(0, daysBetweenISO(v.invoiceDate, v.dueDate));
  const modal = document.getElementById("formModal");
  modal.dataset.editType = ed ? "invoice" : "";
  modal.innerHTML = `
    <div class="modal-head"><h3>${ed ? "Edit invoice "+escHtml(v.invoiceNo) : "New Invoice"}</h3><button class="modal-close" onclick="closeForm()">&times;</button></div>
    <div class="modal-body">
      <div class="section-label">Invoice details</div>
      <div class="form-row">
        <div class="field"><label>Invoice No.</label><input id="f_invoiceNo" value="${escHtml(v.invoiceNo)}"></div>
        <div class="field"><label>Invoice date</label><input id="f_invoiceDate" type="date" value="${escHtml(v.invoiceDate)}" onchange="onTermsChange('f')"></div>
      </div>
      <div class="form-row three">${termsFieldsHtml("f", invTerms, v.dueDate, "invoice")}</div>
      <div class="form-row">
        <div class="field"><label>Customer ref.</label><input id="f_customerRef" placeholder="PO-2026-00x" value="${escHtml(v.customerRef)}"></div>
        <div class="field"><label>Order No.</label><input id="f_orderNo" placeholder="PO-2026-00x" value="${escHtml(v.orderNo)}"></div>
      </div>
      ${ed ? `<div class="form-row">
        <div class="field"><label>Payment status</label><select id="f_status" onchange="onDocStatusChange('f_status','f_paidDate')"><option value="unpaid" ${v.status!=="paid"?"selected":""}>Unpaid</option><option value="paid" ${v.status==="paid"?"selected":""}>Paid</option></select></div>
        <div class="field"><label>Paid date</label><input id="f_paidDate" type="date" value="${escHtml(v.paidDate||"")}" ${v.status==="paid"?"":"disabled"}></div>
      </div>` : ""}

      <div class="section-label">Bill to</div>
      <div class="form-row one"><div class="field"><label>Company name (select existing or type a new one)</label>
        <input id="f_billCompany" list="customerDatalist" placeholder="Berry Mount Vegetables & Fruit Trading LLC" value="${escHtml(b.company==="—"?"":b.company)}" ${ed?"":'oninput="onCustomerSelect(this.value)" onchange="onCustomerSelect(this.value)"'}>
        <datalist id="customerDatalist">${customerDatalistOptions()}</datalist>
      </div></div>
      <div class="form-row one"><div class="field"><label>Address</label><textarea id="f_billAddress" rows="2">${escHtml(b.address)}</textarea></div></div>
      <div class="form-row three">
        <div class="field"><label>Email</label><input id="f_billEmail" value="${escHtml(b.email)}"></div>
        <div class="field"><label>TRN</label><input id="f_billTrn" value="${escHtml(b.trn)}"></div>
        <div class="field"><label>Trade licence</label><input id="f_billLicense" value="${escHtml(b.license)}"></div>
      </div>
      <div class="form-row one"><div class="field"><label>Phone</label><input id="f_billPhone" value="${escHtml(b.phone)}"></div></div>

      <div class="section-label">Shipping</div>
      <div class="form-row three">
        <div class="field"><label>AWB</label><input id="f_awb" value="${escHtml(sh.awb)}"></div>
        <div class="field"><label>Flight</label><input id="f_flight" value="${escHtml(sh.flight)}"></div>
        <div class="field"><label>Airline</label><input id="f_airline" value="${escHtml(sh.airline)}"></div>
      </div>
      <div class="form-row three">
        <div class="field"><label>ETA</label><input id="f_eta" type="date" value="${escHtml(sh.eta)}"></div>
        <div class="field"><label>ETD</label><input id="f_etd" type="date" value="${escHtml(sh.etd)}"></div>
        <div class="field"><label>Incoterms</label><input id="f_incoterms" placeholder="CIF" value="${escHtml(sh.incoterms)}"></div>
      </div>

      <div class="section-label">Items</div>
      <div class="form-row three"><div class="field"><label>Currency</label>${currencySelectHtml("f_currency", v.currency||"£", "onInvCurrencyChange")}</div></div>
      <table class="items-edit-table" id="invItemsTable">
        <thead><tr><th>Name</th><th>Description</th><th>Packing</th><th>Qty</th><th>Gross wt</th><th>Net wt</th><th>UOM</th><th id="invUnitHead">Unit ${escHtml(symOf(v.currency||"£"))}</th><th></th></tr></thead>
        <tbody id="invItemsBody"></tbody>
      </table>
      <button class="btn ghost small" style="margin-top:8px;" onclick="addInvItemRow()">+ Add item</button>
      <div style="text-align:right;margin-top:14px;font-size:14px;">Grand total: <b id="invLiveTotal">${escHtml(v.currency||"£")}0.00</b></div>

      <div class="section-label">Message / notes on invoice (optional)</div>
      <div class="form-row one"><div class="field"><textarea id="f_note" rows="2" placeholder="Shown on the invoice under the totals">${escHtml(v.note)}</textarea></div></div>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" onclick="closeForm()">Cancel</button>
      <button class="btn" onclick="saveInvoice(${ed ? "'"+ed.id+"'" : ""})">${ed ? "Save changes" : "Save invoice"}</button>
    </div>`;
  if(v.items.length){ v.items.forEach(it=>addInvItemRow(it)); } else { addInvItemRow(); addInvItemRow(); }
  document.getElementById("formOverlay").classList.add("show");
}
function onDocStatusChange(selId, dateId){
  const paid = document.getElementById(selId).value==="paid";
  const dt = document.getElementById(dateId);
  dt.disabled = !paid;
  if(paid && !dt.value) dt.value = toISO(new Date());
  if(!paid) dt.value = "";
}
function addInvItemRow(it){
  const tbody = document.getElementById("invItemsBody");
  const tr = document.createElement("tr");
  tr.innerHTML = `
    <td><input class="ii-name" placeholder="Avocado's"></td>
    <td><input class="ii-desc" placeholder="Avocado's | RTE"></td>
    <td><input class="ii-packing" placeholder="10*2 RTE"></td>
    <td><input class="ii-qty" type="number" step="0.01" value="0" oninput="updateInvTotal()" style="width:70px;"></td>
    <td><input class="ii-gross" type="number" step="0.01" value="0" style="width:70px;"></td>
    <td><input class="ii-net" type="number" step="0.01" value="0" style="width:70px;"></td>
    <td><input class="ii-uom" value="Boxes" style="width:70px;"></td>
    <td><input class="ii-price" type="number" step="0.01" value="0" oninput="updateInvTotal()" style="width:80px;"></td>
    <td><button class="rm-row" onclick="this.closest('tr').remove();updateInvTotal();">&times;</button></td>`;
  if(it && typeof it==="object"){
    tr.querySelector(".ii-name").value = it.name||"";
    tr.querySelector(".ii-desc").value = it.desc||"";
    tr.querySelector(".ii-packing").value = it.packing||"";
    tr.querySelector(".ii-qty").value = it.qty!=null?it.qty:0;
    tr.querySelector(".ii-gross").value = it.gross!=null?it.gross:0;
    tr.querySelector(".ii-net").value = it.net!=null?it.net:0;
    tr.querySelector(".ii-uom").value = it.uom||"";
    tr.querySelector(".ii-price").value = it.unitPrice!=null?it.unitPrice:0;
  }
  tbody.appendChild(tr);
  updateInvTotal();
}
function updateInvTotal(){
  let t=0;
  document.querySelectorAll("#invItemsBody tr").forEach(tr=>{
    t += round2((parseFloat(tr.querySelector(".ii-qty").value)||0) * (parseFloat(tr.querySelector(".ii-price").value)||0));
  });
  document.getElementById("invLiveTotal").textContent = formCurrency("f_currency","£")+t.toLocaleString(undefined,{minimumFractionDigits:2});
}
function saveInvoice(editId){
  const ed = editId ? invoices.find(x=>x.id===editId) : null;
  const items = [...document.querySelectorAll("#invItemsBody tr")].map(tr=>({
    name: tr.querySelector(".ii-name").value || "Item",
    desc: tr.querySelector(".ii-desc").value,
    packing: tr.querySelector(".ii-packing").value,
    qty: parseFloat(tr.querySelector(".ii-qty").value)||0,
    gross: parseFloat(tr.querySelector(".ii-gross").value)||0,
    net: parseFloat(tr.querySelector(".ii-net").value)||0,
    uom: tr.querySelector(".ii-uom").value,
    unitPrice: parseFloat(tr.querySelector(".ii-price").value)||0
  })).filter(it=>it.qty>0 || it.unitPrice>0 || it.name!=="Item");
  if(items.length===0){ alert("Add at least one item."); return; }
  if(items.some(it=>it.qty<0 || it.unitPrice<0)){ alert("Quantity and unit price cannot be negative."); return; }
  const invDateVal = document.getElementById("f_invoiceDate").value;
  if(!invDateVal){ alert("Please set the invoice date."); return; }
  const termsDays = termsDaysOf("f");
  const dueDate = addDaysISO(invDateVal, termsDays);
  if(dueDate < invDateVal){ alert("The due date cannot be earlier than the invoice date."); return; }
  if(!document.getElementById("f_billCompany").value.trim()){ alert("Please enter the customer (Bill To company) name."); return; }
  const invoiceNo = document.getElementById("f_invoiceNo").value.trim();
  if(!invoiceNo){ alert("Please enter an invoice number."); return; }
  if(invoices.some(x=>x.invoiceNo===invoiceNo && x.id!==(ed&&ed.id)) && !confirm("Another invoice already uses the number "+invoiceNo+". Save anyway?")) return;
  const fields = {
    invoiceNo,
    invoiceDate: document.getElementById("f_invoiceDate").value,
    dueDate, termsDays,
    customerRef: document.getElementById("f_customerRef").value,
    orderNo: document.getElementById("f_orderNo").value,
    billTo:{
      company: document.getElementById("f_billCompany").value || "—",
      address: document.getElementById("f_billAddress").value,
      email: document.getElementById("f_billEmail").value,
      trn: document.getElementById("f_billTrn").value,
      license: document.getElementById("f_billLicense").value,
      phone: document.getElementById("f_billPhone").value
    },
    shipping:{
      awb: document.getElementById("f_awb").value, flight: document.getElementById("f_flight").value,
      eta: document.getElementById("f_eta").value, etd: document.getElementById("f_etd").value,
      airline: document.getElementById("f_airline").value, incoterms: document.getElementById("f_incoterms").value
    },
    items,
    currency: formCurrency("f_currency","£"),
    note: document.getElementById("f_note").value.trim()
  };
  if(ed){
    const st = document.getElementById("f_status").value;
    fields.status = st;
    fields.paidDate = st==="paid" ? (document.getElementById("f_paidDate").value || ed.paidDate || toISO(new Date())) : null;
    if(fields.paidDate && fields.paidDate < invDateVal){ alert("The paid date cannot be earlier than the invoice date."); return; }
    Object.assign(ed, fields);                 // keeps id, currency and any other field untouched
    saveInvoiceRecord(ed);
    closeForm(); render();
    return;
  }
  const inv = Object.assign({ id: uid("inv"), currency:"£", status:"unpaid", paidDate:null }, fields);
  invoices.push(inv);
  if(invoiceNo === nextInvoiceNumber()) seq.inv++;   // only use up the auto-number if it was actually used
  saveInvoiceRecord(inv);
  saveMeta();
  closeForm(); switchView("invoices");
}

/* ================= PO FORM (new + edit) ================= */
function openPOForm(editId){
  const ed = editId ? purchaseOrders.find(x=>x.id===editId) : null;
  if(editId && !ed){ alert("Purchase order not found."); return; }
  const today = toISO(new Date());
  const v = ed || {
    poNo: nextPONumber(), poDate: today, deliveryDate: addDaysISO(today, settings.expenses.deliveryDays), termsDays: settings.expenses.creditDays, dueDate: addDaysISO(today, settings.expenses.creditDays),
    deliveryDestination: settings.expenses.destination||"", vendor:{}, items:[], note: settings.expenses.message||"", status:"unpaid"
  };
  const vd = v.vendor||{};
  const poDue = v.dueDate || v.deliveryDate;
  const poTerms = (v.termsDays!=null) ? Number(v.termsDays) : Math.max(0, daysBetweenISO(v.poDate, poDue));
  const modal = document.getElementById("formModal");
  modal.dataset.editType = ed ? "po" : "";
  modal.innerHTML = `
    <div class="modal-head"><h3>${ed ? "Edit purchase order "+escHtml(v.poNo) : "New Purchase Order"}</h3><button class="modal-close" onclick="closeForm()">&times;</button></div>
    <div class="modal-body">
      <div class="section-label">PO details</div>
      <div class="form-row three">
        <div class="field"><label>PO No.</label><input id="p_poNo" value="${escHtml(v.poNo)}"></div>
        <div class="field"><label>PO date</label><input id="p_poDate" type="date" value="${escHtml(v.poDate)}" onchange="onTermsChange('p')"></div>
        <div class="field"><label>Delivery date</label><input id="p_deliveryDate" type="date" value="${escHtml(v.deliveryDate)}"></div>
      </div>
      <div class="form-row three">${termsFieldsHtml("p", poTerms, poDue, "po")}</div>
      <div class="form-row one"><div class="field"><label>Delivery destination</label><input id="p_dest" value="${escHtml(v.deliveryDestination)}"></div></div>
      ${ed ? `<div class="form-row">
        <div class="field"><label>Payment status</label><select id="p_status" onchange="onDocStatusChange('p_status','p_paidDate')"><option value="unpaid" ${v.status!=="paid"?"selected":""}>Unpaid</option><option value="paid" ${v.status==="paid"?"selected":""}>Paid</option></select></div>
        <div class="field"><label>Paid date</label><input id="p_paidDate" type="date" value="${escHtml(v.paidDate||"")}" ${v.status==="paid"?"":"disabled"}></div>
      </div>` : ""}

      <div class="section-label">Vendor</div>
      <div class="form-row one"><div class="field"><label>Vendor name (select existing or type a new one)</label>
        <input id="p_vendorName" list="vendorDatalist" placeholder="New Green Overseas B.V." value="${escHtml(vd.name==="—"?"":vd.name)}" ${ed?"":'oninput="onVendorSelect(this.value)" onchange="onVendorSelect(this.value)"'}>
        <datalist id="vendorDatalist">${vendorDatalistOptions()}</datalist>
      </div></div>
      <div class="form-row one"><div class="field"><label>Address</label><textarea id="p_vendorAddress" rows="2">${escHtml(vd.address)}</textarea></div></div>
      <div class="form-row three">
        <div class="field"><label>Phone</label><input id="p_vendorPhone" value="${escHtml(vd.phone)}"></div>
        <div class="field"><label>Email</label><input id="p_vendorEmail" value="${escHtml(vd.email)}"></div>
        <div class="field"><label>VAT No.</label><input id="p_vendorVat" value="${escHtml(vd.vat)}"></div>
      </div>

      <div class="section-label">Items</div>
      <div class="form-row three"><div class="field"><label>Currency</label>${currencySelectHtml("p_currency", v.currency||"$", "onPoCurrencyChange")}</div></div>
      <table class="items-edit-table" id="poItemsTable">
        <thead><tr><th>Name</th><th>Description</th><th>Packing</th><th>Qty</th><th>UOM</th><th id="poUnitHead">Unit ${escHtml(symOf(v.currency||"$"))}</th><th></th></tr></thead>
        <tbody id="poItemsBody"></tbody>
      </table>
      <button class="btn ghost small" style="margin-top:8px;" onclick="addPoItemRow()">+ Add item</button>
      <div style="text-align:right;margin-top:14px;font-size:14px;">Grand total: <b id="poLiveTotal">${escHtml(v.currency||"$")}0.00</b></div>

      <div class="section-label">Message / notes on purchase order (optional)</div>
      <div class="form-row one"><div class="field"><textarea id="p_note" rows="2" placeholder="Shown on the purchase order above the signatures">${escHtml(v.note)}</textarea></div></div>
    </div>
    <div class="modal-foot">
      <button class="btn ghost" onclick="closeForm()">Cancel</button>
      <button class="btn" onclick="savePO(${ed ? "'"+ed.id+"'" : ""})">${ed ? "Save changes" : "Save purchase order"}</button>
    </div>`;
  if(v.items.length){ v.items.forEach(it=>addPoItemRow(it)); } else { addPoItemRow(); addPoItemRow(); }
  document.getElementById("formOverlay").classList.add("show");
}
function addPoItemRow(it){
  const tbody = document.getElementById("poItemsBody");
  const tr = document.createElement("tr");
  tr.innerHTML = `
    <td><input class="pi-name" placeholder="Avocado"></td>
    <td><input class="pi-desc" placeholder="Avocado | RTE"></td>
    <td><input class="pi-packing" placeholder="10*2RTE"></td>
    <td><input class="pi-qty" type="number" step="0.01" value="0" oninput="updatePoTotal()" style="width:80px;"></td>
    <td><input class="pi-uom" value="Boxes" style="width:80px;"></td>
    <td><input class="pi-price" type="number" step="0.01" value="0" oninput="updatePoTotal()" style="width:90px;"></td>
    <td><button class="rm-row" onclick="this.closest('tr').remove();updatePoTotal();">&times;</button></td>`;
  if(it && typeof it==="object"){
    tr.querySelector(".pi-name").value = it.name||"";
    tr.querySelector(".pi-desc").value = it.desc||"";
    tr.querySelector(".pi-packing").value = it.packing||"";
    tr.querySelector(".pi-qty").value = it.qty!=null?it.qty:0;
    tr.querySelector(".pi-uom").value = it.uom||"";
    tr.querySelector(".pi-price").value = it.unitPrice!=null?it.unitPrice:0;
  }
  tbody.appendChild(tr);
  updatePoTotal();
}
function updatePoTotal(){
  let t=0;
  document.querySelectorAll("#poItemsBody tr").forEach(tr=>{
    t += round2((parseFloat(tr.querySelector(".pi-qty").value)||0) * (parseFloat(tr.querySelector(".pi-price").value)||0));
  });
  document.getElementById("poLiveTotal").textContent = formCurrency("p_currency","$")+t.toLocaleString(undefined,{minimumFractionDigits:2});
}
function savePO(editId){
  const ed = editId ? purchaseOrders.find(x=>x.id===editId) : null;
  const items = [...document.querySelectorAll("#poItemsBody tr")].map(tr=>({
    name: tr.querySelector(".pi-name").value || "Item",
    desc: tr.querySelector(".pi-desc").value,
    packing: tr.querySelector(".pi-packing").value,
    qty: parseFloat(tr.querySelector(".pi-qty").value)||0,
    uom: tr.querySelector(".pi-uom").value,
    unitPrice: parseFloat(tr.querySelector(".pi-price").value)||0
  })).filter(it=>it.qty>0 || it.unitPrice>0 || it.name!=="Item");
  if(items.length===0){ alert("Add at least one item."); return; }
  if(items.some(it=>it.qty<0 || it.unitPrice<0)){ alert("Quantity and unit price cannot be negative."); return; }
  const poDateVal = document.getElementById("p_poDate").value;
  if(!poDateVal){ alert("Please set the PO date."); return; }
  const termsDays = termsDaysOf("p");
  const dueDate = addDaysISO(poDateVal, termsDays);
  const deliveryDate = document.getElementById("p_deliveryDate").value;
  if(!deliveryDate){ alert("Please set a delivery date."); return; }
  if(deliveryDate < poDateVal && !confirm("The delivery date is earlier than the PO date. Save anyway?")) return;
  if(!document.getElementById("p_vendorName").value.trim()){ alert("Please enter the vendor name."); return; }
  const poNo = document.getElementById("p_poNo").value.trim();
  if(!poNo){ alert("Please enter a PO number."); return; }
  if(purchaseOrders.some(x=>x.poNo===poNo && x.id!==(ed&&ed.id)) && !confirm("Another purchase order already uses the number "+poNo+". Save anyway?")) return;
  const fields = {
    poNo,
    poDate: document.getElementById("p_poDate").value,
    deliveryDestination: document.getElementById("p_dest").value,
    deliveryDate, dueDate, termsDays,
    vendor:{
      name: document.getElementById("p_vendorName").value || "—",
      address: document.getElementById("p_vendorAddress").value,
      phone: document.getElementById("p_vendorPhone").value,
      email: document.getElementById("p_vendorEmail").value,
      vat: document.getElementById("p_vendorVat").value
    },
    items,
    currency: formCurrency("p_currency","$"),
    note: document.getElementById("p_note").value.trim()
  };
  if(ed){
    const st = document.getElementById("p_status").value;
    fields.status = st;
    fields.paidDate = st==="paid" ? (document.getElementById("p_paidDate").value || ed.paidDate || toISO(new Date())) : null;
    if(fields.paidDate && fields.paidDate < poDateVal){ alert("The paid date cannot be earlier than the PO date."); return; }
    Object.assign(ed, fields);
    savePORecord(ed);
    closeForm(); render();
    return;
  }
  const po = Object.assign({ id: uid("po"), currency:"$", status:"unpaid" }, fields);
  purchaseOrders.push(po);
  if(poNo === nextPONumber()) seq.po++;
  savePORecord(po);
  saveMeta();
  closeForm(); switchView("pos");
}

function closeForm(){ document.getElementById("formOverlay").classList.remove("show"); }

/* ================= DOCUMENT TEMPLATE (matches UKME header / body / footer design) ================= */
function docHeader(titleText, hideVat){
  return `
  <div class="doc-header">
    <div class="logo-block"><img src="${LOGO_B64}" alt="UKME"></div>
    <div class="reg">
      <b>Company Reg. No.:</b> ${escHtml(COMPANY.regNo)}<br>
      ${hideVat ? "" : `<b>Company VAT No.:</b> ${escHtml(COMPANY.vat)}<br>`}
      Address: ${escHtml(COMPANY.addressLines[0]||"")}<br>
      ${COMPANY.addressLines.slice(1).map(escHtml).join("<br>")}
    </div>
  </div>
  <div class="doc-titlebar">${titleText}</div>`;
}
function docFooter(){
  return `
  <div class="doc-footer">
    <span>&#127760; ${escHtml(COMPANY.website)}</span>
    <span>&#9742; ${escHtml(COMPANY.phone)}</span>
    <span>&#9993; ${escHtml(COMPANY.email)}</span>
  </div>`;
}
function itemsTableInvoice(items, cur){
  cur = cur || "£";
  const rows = items.map((it,i)=>`<tr>
    <td>${i+1}</td><td>${escHtml(it.name)}</td><td>${escHtml(it.desc)}</td><td>${escHtml(it.packing)}</td>
    <td class="right">${Number(it.qty).toFixed(2)}</td><td class="right">${Number(it.gross).toFixed(2)}</td>
    <td class="right">${Number(it.net).toFixed(2)}</td><td>${escHtml(it.uom)}</td>
    <td class="right">${cur}${Number(it.unitPrice).toFixed(2)}</td><td class="right">${cur}${lineAmount(it).toFixed(2)}</td>
  </tr>`).join("");
  const gq = items.reduce((s,i)=>s+Number(i.qty),0), gg=items.reduce((s,i)=>s+Number(i.gross),0), gn=items.reduce((s,i)=>s+Number(i.net),0);
  return `<table class="doc-items">
    <thead><tr><th>Sr.No</th><th>Item Name</th><th>Description</th><th>Packing</th><th>Quantity</th><th>Gross Weight</th><th>Net Weight</th><th>UOM</th><th>Unit Price</th><th>Amount</th></tr></thead>
    <tbody>${rows}</tbody>
    <tfoot><tr><td colspan="4" class="center">TOTAL</td><td class="right">${gq.toFixed(2)}</td><td class="right">${gg.toFixed(2)}</td><td class="right">${gn.toFixed(2)}</td><td></td><td></td><td class="right">${cur}${docTotal(items).toFixed(2)}</td></tr></tfoot>
  </table>`;
}
function itemsTablePO(items, cur){
  cur = cur || "$";
  const rows = items.map((it,i)=>`<tr>
    <td>${i+1}</td><td>${escHtml(it.name)}</td><td>${escHtml(it.desc)}</td><td>${escHtml(it.packing)}</td>
    <td class="right">${Number(it.qty).toFixed(2)}</td><td>${escHtml(it.uom)}</td>
    <td class="right">${cur}${Number(it.unitPrice).toFixed(2)}</td><td class="right">${cur}${lineAmount(it).toFixed(2)}</td>
  </tr>`).join("");
  const gq = items.reduce((s,i)=>s+Number(i.qty),0);
  return `<table class="doc-items">
    <thead><tr><th>Sr.No</th><th>Item Name</th><th>Description</th><th>Packing</th><th>Quantity</th><th>UOM</th><th>Unit Price</th><th>Amount</th></tr></thead>
    <tbody>${rows}</tbody>
    <tfoot><tr><td colspan="4" class="center">TOTAL</td><td class="right">${gq.toFixed(2)}</td><td></td><td></td><td class="right">${cur}${docTotal(items).toFixed(2)}</td></tr></tfoot>
  </table>`;
}

function renderInvoiceDoc(inv){
  const total = docTotal(inv.items);
  return `<div class="doc-page inv-doc">
    ${docHeader("INVOICE")}
    <div class="doc-body">
      <div class="two-col">
        <div class="box compact"><h4>Bill To</h4>
          <table class="info-table">
            <tr><td class="label">Company</td><td class="val">${escHtml(inv.billTo.company)}</td></tr>
            <tr><td class="label">Address</td><td class="val">${escHtml(inv.billTo.address)}</td></tr>
            <tr><td class="label">Email</td><td class="val">${escHtml(inv.billTo.email||"—")}</td></tr>
            <tr><td class="label">TRN</td><td class="val">${escHtml(inv.billTo.trn||"—")}</td></tr>
            <tr><td class="label">Licence</td><td class="val">${escHtml(inv.billTo.license||"—")}</td></tr>
            <tr><td class="label">Phone</td><td class="val">${escHtml(inv.billTo.phone||"—")}</td></tr>
          </table>
        </div>
        <div class="box compact"><h4>Invoice Details</h4>
          <table class="info-table">
            <tr><td class="label">Invoice No.</td><td class="val">${escHtml(inv.invoiceNo)}</td></tr>
            <tr><td class="label">Invoice Date</td><td class="val">${fmtDate(inv.invoiceDate)}</td></tr>
            <tr><td class="label">Customer Ref.</td><td class="val">${escHtml(inv.customerRef||"—")}</td></tr>
            <tr><td class="label">Order No.</td><td class="val">${escHtml(inv.orderNo||"—")}</td></tr>
            <tr><td class="label">AWB</td><td class="val">${escHtml(inv.shipping.awb||"—")}</td></tr>
            <tr><td class="label">Flight</td><td class="val">${escHtml(inv.shipping.flight||"—")}</td></tr>
            <tr><td class="label">ETA / ETD</td><td class="val">${inv.shipping.eta?fmtDate(inv.shipping.eta):"—"} / ${inv.shipping.etd?fmtDate(inv.shipping.etd):"—"}</td></tr>
            <tr><td class="label">Airline</td><td class="val">${escHtml(inv.shipping.airline||"—")}</td></tr>
            <tr><td class="label">Incoterms</td><td class="val">${escHtml(inv.shipping.incoterms||"—")}</td></tr>
          </table>
        </div>
      </div>

      ${itemsTableInvoice(inv.items, inv.currency)}

      <div class="totals-strip">
        <div class="box"><h4>Bank Details</h4>
          <table class="info-table">
            <tr><td class="label">Account Name</td><td class="val">${escHtml(COMPANY.name)}</td></tr>
            <tr><td class="label">Bank Name</td><td class="val">${escHtml(COMPANY.bank.bankName)}</td></tr>
            <tr><td class="label">Sort Code</td><td class="val">${escHtml(COMPANY.bank.sortCode)}</td></tr>
            <tr><td class="label">Account No.</td><td class="val">${escHtml(COMPANY.bank.account)}</td></tr>
            <tr><td class="label">IBAN</td><td class="val">${escHtml(COMPANY.bank.iban)}</td></tr>
            <tr><td class="label">SWIFT/BIC</td><td class="val">${escHtml(COMPANY.bank.swift)}</td></tr>
          </table>
        </div>
        <div class="totals-box"><table>
          <tr><td>Subtotal</td><td class="right">${inv.currency||"£"}${total.toFixed(2)}</td></tr>
          <tr><td>Grand Total</td><td class="right">${inv.currency||"£"}${total.toFixed(2)}</td></tr>
        </table></div>
      </div>

      ${inv.note ? `<div class="box" style="margin-top:14px;"><h4>Notes</h4><div style="white-space:pre-line;font-size:10px;">${escHtml(inv.note)}</div></div>` : ""}

      <div class="terms"><h5>Terms &amp; Conditions</h5><ol class="terms-list">
        <li>Payment due within agreed credit terms.</li>
        <li>Delivery discrepancies must be reported within 24 hours.</li>
      </ol></div>

      <div class="sig-row">
        <div class="sig-box"><div class="cap">Prepared By</div><div class="sub">Accounts Department</div><img class="sig-img" src="${currentPreparedSignatureImg()}" alt="signature"><div class="line">Signature / Date: ${fmtDate(inv.invoiceDate)}</div></div>
        <div class="sig-box"><div class="cap">Company Stamp</div><img class="stamp-img" src="${currentStampImg()}" alt="company stamp"></div>
        <div class="sig-box"><div class="cap">Authorised Signature</div><div class="sub">For ${escHtml(COMPANY.name)}</div><img class="sig-img" src="${currentSignatureImg()}" alt="signature"><div class="line">Date: ${fmtDate(inv.invoiceDate)}</div></div>
      </div>

      <div class="thankyou">Thank you for your business. We appreciate the opportunity to serve your fresh produce requirements and look forward to continuing a successful partnership.</div>
    </div>
    ${docFooter()}
  </div>`;
}

function renderPODoc(po){
  const total = docTotal(po.items);
  return `<div class="doc-page po-doc">
    ${docHeader("PURCHASE ORDER", true)}
    <div class="doc-body">
      <div class="box" style="margin-bottom:14px;"><h4>Vendor Information</h4>
        <table class="info-strip">
          <tr>
            <td class="label">Purchase Order No.</td><td class="val">${escHtml(po.poNo)}</td>
            <td class="label">PO Date</td><td class="val">${fmtDate(po.poDate)}</td>
            <td class="label">Delivery Destination</td><td class="val">${escHtml(po.deliveryDestination)}</td>
          </tr>
        </table>
        <table class="info-table">
          <tr><td class="label">Vendor Name</td><td class="val">${escHtml(po.vendor.name)}</td></tr>
          <tr><td class="label">Address</td><td class="val">${escHtml(po.vendor.address)}</td></tr>
          <tr><td class="label">Phone No.</td><td class="val">${escHtml(po.vendor.phone||"—")}</td></tr>
          <tr><td class="label">Email</td><td class="val">${escHtml(po.vendor.email||"—")}</td></tr>
          <tr><td class="label">VAT No.</td><td class="val">${escHtml(po.vendor.vat||"—")}</td></tr>
          <tr><td class="label">Delivery Date</td><td class="val">${fmtDate(po.deliveryDate)}</td></tr>
        </table>
      </div>

      ${itemsTablePO(po.items, po.currency)}

      <div class="totals-strip">
        <div class="box"><h4>Purchase Order Terms</h4><ol class="terms-list">
          <li>PO number must appear on all invoices and shipping documents.</li>
          <li>Goods must meet agreed specifications and quality standards.</li>
          <li>The Supplier is responsible for any costs arising from incorrect, incomplete, or delayed documentation.</li>
          <li>UKME reserves the right to reject non-compliant goods.</li>
          <li>Payment is subject to agreed terms and satisfactory receipt of goods and documents.</li>
        </ol></div>
        <div class="totals-box"><table>
          <tr><td>Subtotal</td><td class="right">${po.currency||"$"}${total.toFixed(2)}</td></tr>
          <tr><td>Grand Total</td><td class="right">${po.currency||"$"}${total.toFixed(2)}</td></tr>
        </table></div>
      </div>

      ${po.note ? `<div class="box" style="margin-top:14px;"><h4>Notes</h4><div style="white-space:pre-line;font-size:10px;">${escHtml(po.note)}</div></div>` : ""}

      <div class="sig-row">
        <div class="sig-box"><div class="cap">Prepared By</div><div class="sub">Procurement Department</div><img class="sig-img" src="${currentPreparedSignatureImg()}" alt="signature"><div class="line">Signature / Date: ${fmtDate(po.poDate)}</div></div>
        <div class="sig-box"><div class="cap">Company Stamp</div><img class="stamp-img" src="${currentStampImg()}" alt="company stamp"></div>
        <div class="sig-box"><div class="cap">Approved By Director</div><div class="sub">&nbsp;</div><img class="sig-img" src="${currentSignatureImg()}" alt="signature"><div class="line">Signature / Date: ${fmtDate(po.poDate)}</div></div>
      </div>
    </div>
    ${docFooter()}
  </div>`;
}

/* ================= PREVIEW + PDF ================= */
let currentPreview = null;
function editCurrentPreview(){ if(currentPreview) editDoc(currentPreview.type, currentPreview.id); }
function previewDoc(type,id){
  const list = type==="invoice"?invoices:purchaseOrders;
  const d = list.find(x=>x.id===id);
  if(!d) return;
  currentPreview = {type,id};
  document.getElementById("previewTitle").textContent = type==="invoice" ? ("Invoice "+d.invoiceNo) : ("Purchase Order "+d.poNo);
  document.getElementById("printArea").innerHTML = type==="invoice" ? renderInvoiceDoc(d) : renderPODoc(d);
  document.getElementById("previewOverlay").classList.add("show");
}
function closePreview(){ document.getElementById("previewOverlay").classList.remove("show"); }

document.getElementById("previewDownloadBtn").addEventListener("click", async ()=>{
  const btn = document.getElementById("previewDownloadBtn");
  if(btn.disabled) return;
  const original = btn.textContent;
  btn.disabled = true; btn.textContent = "Preparing...";
  try{
    const node = document.querySelector("#printArea .doc-page");
    const list = currentPreview.type==="invoice" ? invoices : purchaseOrders;
    const d = list.find(x=>x.id===currentPreview.id);
    const fname = String((currentPreview.type==="invoice" ? d.invoiceNo : d.poNo) || "document").replace(/[\\/:*?"<>|]+/g,"-") + ".pdf";
    await exportNodePDF(node, fname, { fitOnePage:true });
  }catch(e){
    alert("Could not generate PDF: "+e.message);
  }
  btn.disabled = false; btn.textContent = original;
});

/* ================= INIT ================= */
initAuth();
